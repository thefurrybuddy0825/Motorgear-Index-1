<li class="nav--lv1 parent--lv1 site-nav--Megamenu{{ class_hidden }} site-nav--fw{% if active %} site-nav--active{% endif %}{% if forloop.last %} last{% endif %}">
  <a class="site-nav__link--main d-flex align-items-center" href="{{ url }}" title="{{ title }}">
    {% if icon != blank %}
    <div class="site-nav--icon">
      <img class="img-fluid" src="{{ icon | img_url: '50x' }}" alt="image" />
    </div>
    {% endif %}
    <div class="site-nav--title">
    {{ title }}
    {% if desc != blank %}
      <div class="site-nav--desc">{{ desc }}</div>
    {% endif %}
    </div>
    <span class="site-nav--direc"><i class="zmdi zmdi-chevron-down"></i></span>
  </a>
  <div class="nav-dropdown--lv1 megaMenu" style="{% if img_bg != blank %}background-image: url({{ img_bg | img_url: 'master' }});background-repeat: no-repeat;background-size: cover;{% endif %}">
    <div class="site-nav__mega--content row">
      {% if collection_enable %}
        <div class="{{ collection_xl }} {{ collection_lg }} site--nav-collection mb-md-30">
          {% for i in (1..5) %}
            {%- assign name_collecId = 'name_collec_' | append: i -%}
            {%- assign linkId = 'link' | append: i -%}
            {% if [name_collecId] != blank %}
              <div class="nav--collec-item">
                <a href="{{ [linkId] }}">
                  <span>{{ [name_collecId] }}</span>
                  <i class="zmdi zmdi-chevron-right"></i>
                </a>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
      {% if novmenu_menu_enable %}
        <div class="{{ novmenu_xl }} {{ novmenu_lg }}">
          <div class="row">
            {% for novLink1 in linklists[child_list_handle].links %}
            {% assign linkHandle = novLink1.title | handleize %}
            <div class="{{ submenu_xl }} {{ submenu_lg }} mb-md-20">
              <ul class="site-nav--MenuLinks">
                <li{% if three_level_nav %} class="site-nav__link--title{% if show_title == false %} hidden{% endif %}"{% endif %}>
                  <a href="{{ novLink1.url }}">{{ novLink1.title }}</a>
                </li>
                {% for novLink2 in linklists[linkHandle].links %}
                  <li>
                    <a href="{{ novLink2.url }}" class="site-nav__link">{{ novLink2.title }}</a>
                  </li>
                {% endfor %}
              </ul>
            </div>
            {% endfor %}
          </div>
        </div>
      {% endif %}

      {% if block.settings.novmenu_banner_enable1 %}
        <div class="{{ block.settings.banner_1_xl }} {{ block.settings.banner_1_lg }}{% if block.settings.class_bn1 != blank %} {{ block.settings.class_bn1 }}{% endif %}">
          <div class="novMenuBanner" style="border-radius: {{ block.settings.banner_br }}px; overflow: hidden;">
            {% if block.settings.novmenu_banner_link1 != blank %}<a href="{{ block.settings.novmenu_banner_link1 }}">{% endif %}
              {% if block.settings.novmenu_banner1 != blank %}
                <img class="img-fluid lazyload w-100" alt="{{ block.settings.novmenu_banner1.alt | default: shop.name }}" data-src="{{ block.settings.novmenu_banner1 | img_url: block.settings.image_size1 }}" />
              {% else %}
                <img class="img-fluid lazyload w-100" alt="{{ shop.name }}" data-src="https://via.placeholder.com/{{ block.settings.image_size1 }}" />
              {% endif %}
            {% if block.settings.novmenu_banner_link1 != blank %}</a>{% endif %}
          </div>
        </div>
      {% endif %}

      {% if block.settings.novmenu_banner_enable2 %}
        <div class="{{ block.settings.banner_2_xl }} {{ block.settings.banner_2_lg }}{% if block.settings.class_bn2 != blank %} {{ block.settings.class_bn1 }}{% endif %}">
          <div class="novMenuBanner" style="border-radius: {{ block.settings.banner_br }}px; overflow: hidden;">
            {% if block.settings.novmenu_banner_link2 != blank %}<a href="{{ block.settings.novmenu_banner_link2 }}">{% endif %}
              {% if block.settings.novmenu_banner2 != blank %}
              <img class="img-fluid lazyload w-100" alt="{{ block.settings.novmenu_banner2.alt | default: shop.name }}" data-src="{{ block.settings.novmenu_banner2 | img_url: block.settings.image_size2 }}" />
              {% else %}
              <img class="img-fluid lazyload w-100" alt="{{ shop.name }}" data-src="https://via.placeholder.com/{{ block.settings.image_size2 }}" />
              {% endif %}
            {% if block.settings.novmenu_banner_link2 != blank %}</a>{% endif %}
          </div>
        </div>
      {% endif %}

      {% if block.settings.novmenu_banner_enable3 %}
        <div class="{{ block.settings.banner_3_xl }} {{ block.settings.banner_3_lg }}{% if block.settings.class_bn3 != blank %} {{ block.settings.class_bn1 }}{% endif %}">
          <div class="novMenuBanner" style="border-radius: {{ block.settings.banner_br }}px; overflow: hidden;">
            {% if block.settings.novmenu_banner_link3 != blank %}<a href="{{ block.settings.novmenu_banner_link3 }}">{% endif %}
              {% if block.settings.novmenu_banner3 != blank %}
                <img class="img-fluid lazyload w-100" alt="{{ block.settings.novmenu_banner3.alt | default: shop.name }}" data-src="{{ block.settings.novmenu_banner3 | img_url: block.settings.image_size3 }}" />
              {% else %}
                <img class="img-fluid lazyload w-100" alt="{{ shop.name }}" data-src="https://via.placeholder.com/{{ block.settings.image_size3 }}" />
              {% endif %}
            {% if block.settings.novmenu_banner_link3 != blank %}</a>{% endif %}
          </div>
        </div>
      {% endif %}

      {% if block.settings.product_enable %}
        <div class="{{ block.settings.product_xl }} {{ block.settings.product_lg }} nav--product mt-sm-30">
          <div class="site-nav--title__product"><span class="text-uppercase">{{ block.settings.title_product }}</span></div>
          <div class="megamenu-product-slider grid--view-items row" data-autoplay= "{{ block.settings.autoplay }}">
            {%- assign img_size = '260x' -%}
            {% if block.settings.product_1 != blank %}
              {% assign product = all_products[block.settings.product_1] %}
              <div class="item col">
                <div class="item-product mb-0 pb-10">
                  <div class="thumbnail-container">
                    <a href="{{ product.url | within: collection }}">
                      {% assign img_url = product.featured_image %}
                      {%- assign imagealt = img_url.alt | default: product.title | strip_html | escape -%}
                      {{ img_url | image_url: width: 1920 | image_tag:
                        loading: 'lazy',
                        class: 'product__thumbnail lazyload img-fluid',
                        alt: imagealt,
                        widths: '200, 350, 525, 768, 992, 1200, 1440, 1920'
                      }}
                    </a>
                  </div>
                  <div class="product__info">
                    <div class="product__title">
                      <a href="{{ product.url | within: collection }}">{{ product.title }}</a>
                    </div>
                    <div class="product__price">
                      {% render 'product-price' %}
                    </div>
                  </div>
                </div>
              </div>
            {% endif %}
            {% if block.settings.product_2 != blank %}
              {% assign product = all_products[block.settings.product_2] %}
              <div class="item col">
                <div class="item-product mb-0 pb-10">
                  <div class="thumbnail-container">
                    <a href="{{ product.url | within: collection }}">
                      {% assign img_url = product.featured_image %}
                      {%- assign imagealt = img_url.alt | default: product.title | strip_html | escape -%}
                      {{ img_url | image_url: width: 1920 | image_tag:
                        loading: 'lazy',
                        class: 'product__thumbnail lazyload img-fluid',
                        alt: imagealt,
                        widths: '200, 350, 525, 768, 992, 1200, 1440, 1920'
                      }}
                    </a>
                  </div>
                  <div class="product__info">
                    <div class="product__title">
                      <a href="{{ product.url | within: collection }}">{{ product.title }}</a>
                    </div>
                    <div class="product__price">
                      {% render 'product-price' %}
                    </div>
                  </div>
                </div>
              </div>
            {% endif %}
            {% if block.settings.product_3 != blank %}
              {% assign product = all_products[block.settings.product_3] %}
              <div class="item col">
                <div class="item-product mb-0 pb-10">
                  <div class="thumbnail-container">
                    <a href="{{ product.url | within: collection }}">
                      {% assign img_url = product.featured_image %}
                      {%- assign imagealt = img_url.alt | default: product.title | strip_html | escape -%}
                      {{ img_url | image_url: width: 1920 | image_tag:
                        loading: 'lazy',
                        class: 'product__thumbnail lazyload img-fluid',
                        alt: imagealt,
                        widths: '200, 350, 525, 768, 992, 1200, 1440, 1920'
                      }}
                    </a>
                  </div>
                  <div class="product__info">
                    <div class="product__title">
                      <a href="{{ product.url | within: collection }}">{{ product.title }}</a>
                    </div>
                    <div class="product__price">
                      {% render 'product-price' %}
                    </div>
                  </div>
                </div>
              </div>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</li>
