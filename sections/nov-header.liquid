{%- liquid
  assign sst = section.settings
  if settings.lang_iso_rtl != blank
    assign list_iso_rtl = settings.lang_iso_rtl | downcase
    if list_iso_rtl contains request.locale.iso_code
      assign iso_rtl = true
    else
      assign iso_rtl = false
    endif
  endif
-%}
{%- style -%}

  @media(min-width: 768px) {
    .site-nav--btn {
      color: var(--color-icons);
    }
    .site-header__logo {
      max-width: {{ sst.w_logo_md }}px;
    }
  }
  @media(min-width: 992px) {
    .site-header__logo {
      max-width: {{ sst.w_logo_lg }}px;
    }
  }
  @media(min-width: 1200px) {
    .site-header__logo {
      max-width: {{ sst.w_logo }}px;
    }
  }
  .header-top {
    {% if section.settings.bg_header_top != blank %}
      background-color: {{ section.settings.bg_header_top }};
    {% endif %}
  }
  .header-top .header-cu-lang .dropdown > button,
  .header-top .header-cu-lang .dropdown .current-currency,
  .header-top .header-account-text .title-account {
    color: {{ section.settings.color_text_sp }};
  }

{%- endstyle %}
<header
  class="site-header{% if sst.stickymenu %} sticky-header{% endif %}"
  data-section-id="{{ section.id }}"
  data-section-type="nov-slick">
  <div class="header-top d-none d-md-block position-relative">
    <div class="container">
      <div class="row">
        <div class="site-header_top_left d-flex align-items-center justify-content-start col-6">
          <span style="color: {{ section.settings.color_text_sp }}">{{ section.settings.text_sp }}</span>
          <span class="text-call" style="color: {{ section.settings.color_text_call }}">{{ section.settings.text_call }}</span>
        </div>
        <div class="d-flex align-items-center flex-grow-1 justify-content-end site-header_top_right col-6">
          <div class="header-account d-flex align-items-center position-relative">
            <div class="header-group-icon d-flex align-items-center" nov-btn-act
                data-toggle="header_settings"
                overlay>
              <div
                  class="header-icon"
                  nov-btn-act
                  data-toggle="header_settings"
                  overlay>
                  {% if sst.account_svg != blank %}
                    {{ sst.account_svg }}
                  {% else %}
                    <i class="{{ sst.account_icon }} position-relative"></i>
                  {% endif %}
              </div>

              <div class="header-account-text">
                {% if customer %}
                  <div class="title-account d-flex flex-column">
                    <span class="font-700 welcome">{{ 'customer.welcome' | t }}</span>
                    <span class="account-name">{{ customer.name }}</span>
                  </div>
                {% else %}
                  <div class="title-account">
                    <span class="account-sign">{{ 'customer.account.sign_in_regiter' | t }}</span>
                  </div>
                {% endif %}
                </div>
            </div>
          </div>
          <div class="header-cu-lang d-flex align-items-center">
            {%- if settings.show_language and localization.available_languages.size > 1 -%}
              <div class="header-language d-none d-md-block">
              {% include 'nov-block-language' , id: 'header-language' color: "#fff" %}
              </div>
            {%- endif -%}
            {% if settings.show_multiple_currencies %}
              <div class="header-currency">
                {% include 'nov-block-currency', type: 'dropdown', color: "#fff" %}
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="header-center d-none d-md-block {% if request.page_type == 'index' %}color-{{ sst.color_header }}{% else %}color-{{ sst.color_header_inner }}{% endif %}">
    <div class="container">
      <div class="row">
        <div class="col-md-3 d-flex align-items-center">
          <div class="site-nav--btn d-xl-none hover:c_df">
            <i class="rbb-icon-menu-7"></i>
          </div>
          <div class="contentsticky_logo text-center">
            {% if sst.logo %}
              <a
                href="{{ routes.root_url }}"
                class="site-header__logo d-block"
                style="max-width: {{ sst.w_logo }}px">
                {%- assign logoalt = sst.logo.alt | default: shop.name | strip_html | escape -%}
                {{ sst.logo | image_url: width: 600 | image_tag: loading: 'lazy', class: 'img-fluid', alt: logoalt, widths: '300 400 600 800'
                }}
              </a>
            {% else %}
              <div class="h2 site-header__logo d-inline-block mb-0">
                <a
                  class="site-header__logo-link"
                  href="/"
                  itemprop="url">{{ shop.name }}</a>
              </div>
            {% endif %}
          </div>
        </div>
        <div class="col-xl-6 align-items-center justify-content-center d-none d-xl-flex">
          <div class="contentsticky_menu col-md-12 text-center d-none d-xl-block">
            <nav id="AccessibleNav">{% render 'site-nav' %}</nav>
          </div>
        </div>
        <div class="header-group-item col-xl-3 col-md-9 d-flex align-items-center justify-content-end">
	    <div class="site-header__search d-flex align-items-center justify-content-end">
	      <div class="search__btn-overlay pointer d-flex" nov-btn-act data-toggle="search_canvas" overlay>
	        {% render 'icon-search', color: "white" %}
	      </div>
	    </div>
          {% if settings.wishlist_enable %}
            <div class="contentsticky_wishlist header--wishlist">
              <a href="{{ settings.link_page_wishlist }}" class="position-relative text-center">
                <span
                  class="header-icon"
                  rel="nofollow"
                  title="{{ 'layout.customer.wishlists' | t }}">
                  {% if sst.wishlist_svg != blank %}
                    {{ sst.wishlist_svg }}
                  {% else %}
                    <i class="{{ sst.wishlist }} position-relative"></i>
                  {% endif %}
                  <span class="WishlistCount position-absolute text-center rounded-circle">0</span>
                </span>
                <span class="text-wishlist">
                  {{ 'layout.customer.wishlists' | t }}
                </span>
              </a>
            </div>
          {% endif %}
          <div class="contentsticky_cart cart_canvas">
            <div id="cart_block">
              <div class="header-cart d-flex justify-content-center">
                <div class="site-header__cart text-center">
                  <span class="site-header__cart-count" title="{{ 'layout.cart.title_cart' | t }}">
                    <span id="CartCount">{{ cart.item_count }}</span>
                  </span>
                  <div class="site-header__cart-icon header-icon">
                    {% if sst.cart_svg != blank %}
                      {{ sst.cart_svg }}
                    {% else %}
                      <i class="rbb-icon-shopping-{{ sst.cart_type }}-{{ sst.cart }} position-relative"></i>
                    {% endif %}
                  </div>
                  <span class="text-cart">
                    {{ 'layout.cart.title_cart' | t }}
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="header-mobile d-md-none color-{{ sst.color_header_sm }}{% if sst.stickymenu_sm == true %} sticky-header-mobile{% endif %}">
    <div class="header-mobile-content">
      <div class="row align-items-center h-100 justify-content-between">
        <div class="d-flex align-items-center">
          <div id="show-megamenu" class="item-mobile-top">
            <div class="icon-directional position-absolute"></div>
          </div>
          <div class="mobile-btn_search item-mobile-top">
            {% render 'icon-search' %}
            <i class="zmdi zmdi-close"></i>
          </div>
          <div id="mobile_search">
            {% render 'nov-formsearch-inline' %}
          </div>
        </div>
        <div class="mobile_logo  text-center">
          {% if sst.logo_mobile %}
            <a href="/" class="site-header__logo-image img-fluid d-inline-block">
              {%- assign image_size = sst.wm_logo | append: 'x' -%}
              <img
                srcset="{{ sst.logo_mobile | img_url: image_size }} 1x, {{ sst.logo_mobile | img_url: image_size, scale: 2 }} 2x"
                src="{{ sst.logo_mobile | img_url: width: sst.w_logo | append: 'x' }}"
                loading="lazy"
                width="{{ sst.logo_mobile.width }}"
                height="{{ sst.logo_mobile.height }}"
                alt="{{ sst.logo_mobile.alt | default: shop.name | escape }}"
                style="height: auto; max-width: {{ sst.wm_logo }}px;">
            </a>
          {% else %}
            <a
              class="site-header__logo-link"
              href="/"
              itemprop="url">{{ shop.name }}</a>
          {% endif %}
        </div>
        <div class="mobile_cart d-flex justify-content-end">
          <div class="cart_canvas">
            <div class="header-cart d-flex justify-content-center">
              <div class="site-header__cart d-flex justify-content-center align-items-center position-relative">
                <span class="cart-count position-absolute" title="{{ 'layout.cart.title_cart' | t }}">
                  <span id="CartCount">{{ cart.item_count }}</span>
                </span>
                <div class="site-header__cart-icon">
                  <i class="rbb-icon-shopping-bag-6"></i>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>
{% render 'nov-search-canvas' %}
{% if sst.stickymenu == true %}
  <div id="header-sticky" class="d-none d-md-block color-{{ sst.color_header_sticky }}">
    <div class="{{ sst.container }}">
      <div class="bl_content row align-items-center">
        <div class="col-md-3">
          <div class="contentstickynew_logo"></div>
        </div>
        <div class="col-md-6 d-flex justify-content-center">
          <div class="contentstickynew_menu d-none d-xl-block"></div>
        </div>
        <div class="col-md-3">
          <div class="header-group-item d-flex align-items-center justify-content-end">
            {% if settings.wishlist_enable %}
              <div class="contentstickynew_wishlist"></div>
            {% endif %}
            <div class="contentstickynew_cart"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
{% endif %}
<div class="d-none">
  <nav id="AccessibleNavMobile">{% render 'site-nav-mobile' %}</nav>
</div>
