{%- assign sst = section.settings -%}
{% style %}
  {%- assign bg_image = sst.background_image -%}
  #shopify-section-{{ section.id }} .distance {
    padding-top: {{ sst.distance_top_xs }}px;
    padding-bottom: {{ sst.distance_bottom_xs }}px;
    {% if sst.background_color != blank or bg_image != blank %}
      background: {{ sst.background_color }}{% if bg_image != blank %} url("{{ bg_image | img_url: '' }}"){% endif %} center;
      background-size: cover;
    {% endif %}
    {%- if sst.gradient != blank -%}background: {{ sst.gradient }};{%- endif -%}
  }
  @media(min-width: 768px) {
    #shopify-section-{{ section.id }} .distance {
      padding-top: {{ sst.distance_top_md }}px;
      padding-bottom: {{ sst.distance_bottom_md }}px;
    }
  }
  @media(min-width: 1200px) {
    #shopify-section-{{ section.id }} .distance {
      padding-top: {{ sst.distance_top_xl }}px;
      padding-bottom: {{ sst.distance_bottom_xl }}px;
    }
  }
  #shopify-section-{{ section.id }} .collec-item {
    border-radius: {{ sst.img_corner }}px;
    background-color: {{ sst.bg_item }};
  }
  #shopify-section-{{ section.id }} .respone_image {
    border-radius: {{ sst.img_corner }}px {{ sst.img_corner }}px 0 0;
  }
  #shopify-section-{{ section.id }} .collec-title {
    font-size: {{ sst.t_s | divided_by: 10.0 }}rem;
  }
  #shopify-section-{{ section.id }} .collec-desc {
    font-size: {{ sst.st_s | divided_by: 10.0 }}rem;
  }
{% endstyle %}
<div class="distance position-relative color-{{ sst.color_section }}{% if sst.class_section != blank %} {{ sst.class_section }}{% endif %}{% if sst.animate  %} wow fadeInUp animated{% endif %}" data-section-id="{{ section.id }}" data-section-type="nov-slick">
  <div class="{{ sst.container }}">
    {% render 'heading-section' %}
    <div class="nov-slick-carousel spacing-60 spacing-lg-30{% if sst.show_dot %} pb-40{% endif %}"
      data-autoplay="{{ sst.autoplay }}"
      data-autoplaytimeout="{{ sst.autoplay_speed }}"
      data-loop="true"
      data-nav="false"
      data-dots="{{ sst.show_dot }}"
      data-items_xxl="3"
      data-items="3"
      data-items_lg="3"
      data-items_md="3"
      data-items_sm="1"
      data-items_xs="1"
      data-row="1"
      {% if sst.one_slider %}data-oneslider="1"{% endif %}
      {% if sst.show_nav %}data-custnav{% endif %}>
      {% for block in section.blocks %}
      {% assign bst = block.settings %}
      <div class="block sp-item{% render 'number-to-col' %}">
        <div class="collec-item position-relative nov-sh-image-2">
          {% if bst.image != blank %}
            {% render 'nov-aspect-image', image: bst.image %}
          {% else %}
            {%- capture current -%}{% cycle 1, 2, 3, 4 %}{%- endcapture -%}
            {{ 'collection-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
          <div class="block-bottom d-flex align-items-center">
            <div>
              {% if bst.cta_label != blank %}
                <div class="collec-title">{{ bst.cta_label }}</div>
              {% endif %}
              {% if bst.desc != blank %}
                <div class="collec-desc mt-10">{{ bst.desc }}</div>
              {% endif %}
            </div>
            {% if sst.show_btn %}
              <a href="{{ bst.link }}" class="link btn">
                <i class="zmdi zmdi-long-arrow-right"></i>
              </a>
            {% endif %}
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
    {% if sst.show_nav %}
      <div class="block-nav d-md-flex justify-content-center d-none">
        <div class="nav-slider nav-prev">{% render 'icon-arrow-prev' %}</div>
        <div class="nav-slider nav-next">{% render 'icon-arrow-next' %}</div>
      </div>
    {% endif %}
  </div><!-- End container -->
</div>
{% if section.blocks.size == 0 %}
  {% render 'no-blocks' %}
{% endif %}

{% schema %}
  {
    "name": "Vinova Collection Summary",
    "class": "section-collection-summary",
    "settings": [
      {
        "type": "richtext",
        "id": "heading",
        "label": "Heading",
        "default": "<p>Vinova Collection Summary</p>"
      },
      {
        "type": "color",
        "id": "heading_color",
        "label": "Heading color",
        "default": "#222222"
      },
      {
        "type": "richtext",
        "id": "subheading",
        "label": "Sub heading",
        "default": "<p>Subtitle from happy customers</p>"
      },
      {
        "type": "color",
        "id": "subheading_color",
        "label": "Sub heading color",
        "default": "#666666"
      },
      {
        "type": "select",
        "id": "heading_alignment",
        "label": "Heading alignment",
        "default": "text-left",
        "options": [
          {
            "value": "text-left",
            "label": "Left"
          },
          {
            "value": "text-center",
            "label": "Center"
          },
          {
            "value": "text-right",
            "label": "Right"
          }
        ]
      },
      {
        "type":  "header",
        "content": "Slider option"
      },
      {
        "type": "checkbox",
        "id": "one_slider",
        "label": "One slides to scroll",
        "default":   false
      },
      {
        "type": "checkbox",
        "id": "autoplay",
        "label": "Auto-rotate slides",
        "default": true
      },
      {
        "type": "select",
        "id": "autoplay_speed",
        "label": "Change slides every",
        "options": [
          { "value": "4000", "label": "4 seconds" },
          { "value": "5000", "label": "5 seconds" },
          { "value": "6000", "label": "6 seconds" },
          { "value": "7000", "label": "7 seconds" },
          { "value": "8000", "label": "8 seconds" },
          { "value": "9000", "label": "9 seconds" },
          { "value": "10000", "label": "10 seconds" }
        ],
        "default": "4000"
      },
      {
        "type": "checkbox",
        "id": "show_dot",
        "label": "Show dots slider",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_nav",
        "label": "Show nav slider",
        "default": true
      },
      {
        "type": "header",
        "content": "Style item"
      },
      {
        "type": "range",
        "id": "img_corner",
        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "px",
        "label": "Image corner",
        "default": 20
      },
      {
        "type": "header",
        "content": "Heading"
      },
      {
        "type": "range",
        "id": "t_s",
        "min": 11,
        "max": 50,
        "step": 1,
        "label": "Heading size",
        "default": 18,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "st_s",
        "min": 11,
        "max": 50,
        "step": 1,
        "label": "Description size",
        "default": 13,
        "unit": "px"
      },
      {
        "type": "checkbox",
        "id": "show_btn",
        "label": "Show button",
        "default": true
      },
      {
        "type": "header",
        "content": "Design section"
      },
      {
        "type": "checkbox",
        "id": "animate",
        "label": "Show animated",
        "default":   true
      },
      {
        "type": "select",
        "id": "container",
        "label": "Container",
        "default": "container",
        "options": [
          { "value": "container", "label": "Container" },
          { "value": "container-fluid", "label": "Container fluid" },
          { "value": "container-full", "label": "Container full width" }
        ]
      },
      {
        "type": "color_scheme",
        "id": "color_section",
        "label": "Color section",
        "default": "background-1"
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Background colors"
      },
      {
        "type": "image_picker",
        "id": "background_image",
        "label": "Background image"
      },
      {
        "type": "color_background",
        "id": "gradient",
        "label": "Background gradient"
      },
      {
        "type": "text",
        "id": "class_section",
        "label": "Class"
      },
      {
        "type": "header",
        "content": "Spacing top (px)"
      },
      {
        "type": "number",
        "id": "distance_top_xl",
        "label": "Large laptop",
        "default": 30,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "distance_top_md",
        "label": "Tablet",
        "default": 30,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "distance_top_xs",
        "label": "Mobile",
        "default": 30
      },
      {
        "type": "header",
        "content": "Spacing bottom (px)"
      },
      {
        "type": "number",
        "id": "distance_bottom_xl",
        "label": "Large laptop",
        "default": 30,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "distance_bottom_md",
        "label": "Tablet",
        "default": 30,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "distance_bottom_xs",
        "label": "Mobile",
        "default": 30
      }
    ],
    "blocks": [
      {
        "type": "image",
        "name": "Image",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "url",
            "id": "link",
            "label": "Link"
          },
          {
            "type": "text",
            "id": "cta_label",
            "label": "Heading",
            "default": "Lorem ipsum"
          },
          {
            "type": "richtext",
            "id": "desc",
            "label": "Description",
            "default": "<p>Quisque id odio sit amet erat viverra</p>"
          },
          {
            "type": "text",
            "id": "class",
            "label": "Class"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Vinova Collection Summary",
        "category": "Image",
        "blocks": [
          {
            "type": "image"
          },
          {
            "type": "image"
          },
          {
            "type": "image"
          }
        ]
      }
    ]
  }
{% endschema %}
