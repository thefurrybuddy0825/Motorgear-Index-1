{%- assign sst = section.settings -%}

{% style %}
  #shopify-section-{{ section.id }} .distance {
    padding-top: {{ sst.distance_top_xs }}px;
    padding-bottom: {{ sst.distance_bottom_xs }}px;
    {% if sst.background_color != blank %}
      background: {{ sst.background_color }}
      {% if bg_image != blank %} url("{{ bg_image | img_url: '1920x' }}"){% endif %}
    no-repeat center;
      background-size: cover;
      background: {{ sst.gradient_color }};
    {% endif %}
  }
  #shopify-section-{{ section.id }}
  .text-left .title {
    color: {{ sst.heading_color }}
  }
  #shopify-section-{{ section.id }}
  .text-left .sub_tittle {
    color: {{ sst.subheading_color }}
  }
  @media(min-width: 768px) {
    #shopify-section-{{ section.id }} .distance {
      padding-top: {{ sst.distance_top_md }}px;
      padding-bottom: {{ sst.distance_bottom_md }}px;
    }
  }
  @media(min-width: 1200px) {
    #shopify-section-{{ section.id }} .distance {
      padding-top: {{ sst.distance_top_xl }}px;
      padding-bottom: {{ sst.distance_bottom_xl }}px;
    }
  }
{% endstyle %}
<div
  class="distance {% if sst.class != blank %} {{ sst.class }}{% endif %} {% if sst.animate %} wow fadeInUp animated{% endif %}"
  data-section-id="{{ section.id }}"
  data-section-type="nov-slick">
  <div class="{{ sst.container }} color-{{ sst.color_gdpr }}">
    <div class="row spacing-15">
      <div class="col-lg-4 d-flex align-items-center">
        <div class="title_section {{ sst.heading_alignment }}">
          <h2 class="title text-uppercase">{{ sst.heading }}</h2>
          <div class="sub_tittle">
            {{ sst.subheading }}
          </div>
          {% if sst.text_button != blank %}
            <a href="{{ sst.link_button |  default : "#" }}" class="btn {{ sst.btn_type }} {{ sst.btn_size }} text-uppercase font-medium f_pr">{{ sst.text_button }}</a>
          {% endif %}
        </div>
      </div>
      <div class="col-lg-8 content-block-category">
        <div
          class="nov-slick-center-carousel"
          data-autoplay="false"
          data-autoplaytimeout="6000"
          data-loop="false"
          data-dots="false"
          data-nav="true"
          {% if sst.show_nav %}
          data-custnav{% endif %}>
          {% for block in section.blocks %}
            {% assign bst = block.settings %}
            <div class="sp_item pl-0 pr-0">
              <div class="block_image">
                {% if bst.image_block != blank %}
                  {%- assign imagealt = bst.image_block.alt | default: 'icon-text' | strip_html | escape -%}
                  {{ bst.image_block | image_url: width: 2048 | image_tag:
                    loading: 'lazy',
                    class: 'img-fluid',
                    alt: imagealt,
                    widths: '200, 320, 525, 768, 992, 1200, 1440, 1920, 2048'
                  }}
                {% else %}
                  {% capture current %}{% cycle 1, 2, 3, 4 %}{% endcapture %}
                  {{ 'product-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg' | replace: '<svg', '<svg style="max-width: 350px"' }}
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
        <div
          class="nov-slick-center-carousel-navfor"
          data-dots="false"
          data-nav="true">
          {% for block in section.blocks %}
            {% assign bst = block.settings %}
            <div class="sp_item pl-0 pr-0">
              <div class="text-slide" style="color: {{ bst.color_name }};">
                {{ bst.text_slide }}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Vinova Category Slide",
    "class": "section-cat-slide",
    "settings": [
      {
        "type": "inline_richtext",
        "id": "heading",
        "label": "Heading",
        "default": "Featured categories"
      },
      {
        "type": "color",
        "id": "heading_color",
        "label": "Heading color",
        "default": "#222222"
      },
      {
        "type": "richtext",
        "id": "subheading",
        "label": "Sub heading",
        "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt uticare labore et dolore magna aliqua.</p>"
      },
      {
        "type": "color",
        "id": "subheading_color",
        "label": "Sub heading color",
        "default": "#666666"
      },
      {
        "type": "select",
        "id": "heading_alignment",
        "label": "Heading alignment",
        "default": "text-left",
        "options": [
          {
            "value": "text-left",
            "label": "Left"
          },
          {
            "value": "text-center",
            "label": "Center"
          },
          {
            "value": "text-right",
            "label": "Right"
          }
        ]
      },
      {
        "type": "text",
        "id": "text_button",
        "label": "Text Button",
        "default": "Learn More"
      },
      {
        "type": "color",
        "id": "color_button",
        "label": "Color button Text",
        "default": "#ffffff"
      },
      {
        "type": "url",
        "id": "link_button",
        "label": "Link Button"
      },
      {
        "type": "select",
        "id": "btn_type",
        "label": "Button type",
        "default": "btn-primary",
        "options": [
          {
            "value": "btn-primary",
            "label": "Primary"
          },
          {
            "value": "btn-secondary",
            "label": "Secondary"
          }
        ]
      },
      {
        "type": "select",
        "id": "btn_size",
        "label": "Button size",
        "default": "btn-normal",
        "options": [
          {
            "value": "btn-normal",
            "label": "Normal"
          },
          {
            "value": "btn-medium",
            "label": "Medium"
          },
          {
            "value": "btn-large",
            "label": "Large"
          }
        ]
      },
      {
        "type": "color_scheme",
        "id": "color_gdpr",
        "label": "Color",
        "default": "background-1"
      },
      {
        "type": "checkbox",
        "id": "animate",
        "label": "Show animated",
        "default": true
      },
      {
        "type": "select",
        "id": "container",
        "label": "Container",
        "default": "container",
        "options": [
          {
            "value": "container",
            "label": "Container"
          },
          {
            "value": "container-fluid",
            "label": "Container fluid"
          },
          {
            "value": "container-full",
            "label": "Container full width"
          }
        ]
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Background colors"
      },
      {
        "type": "color_background",
        "id": "gradient_color",
        "label": "Background gradient"
      },
      {
        "type": "image_picker",
        "id": "background_image",
        "label": "Background image"
      },
      {
        "type": "text",
        "id": "class",
        "label": "Class"
      },
      {
        "type": "header",
        "content": "Spacing top (px)"
      },
      {
        "type": "number",
        "id": "distance_top_xl",
        "label": "Large laptop",
        "default": 30,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "distance_top_md",
        "label": "Tablet",
        "default": 30,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "distance_top_xs",
        "label": "Mobile",
        "default": 30
      },
      {
        "type": "header",
        "content": "Spacing bottom (px)"
      },
      {
        "type": "number",
        "id": "distance_bottom_xl",
        "label": "Large laptop",
        "default": 30,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "distance_bottom_md",
        "label": "Tablet",
        "default": 30,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "distance_bottom_xs",
        "label": "Mobile",
        "default": 30
      }
    ],
    "blocks": [
      {
        "type": "image",
        "name": "Image",
        "limit": 6,
        "settings": [
          {
            "type": "image_picker",
            "id": "image_block",
            "label": "Image"
          },
          {
            "type": "text",
            "id": "text_slide",
            "label": "Category Name",
            "default": "Lorem ipsum"
          },
          {
            "type": "color",
            "id": "color_name",
            "label": "Color Name",
            "default": "#222222"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Vinova Category Slide",
        "blocks": [
          {
            "type": "image"
          },
          {
            "type": "image"
          },
          {
            "type": "image"
          },
          {
            "type": "image"
          },
          {
            "type": "image"
          },
          {
            "type": "image"
          }
        ]
      }
    ]
  }
{% endschema %}
