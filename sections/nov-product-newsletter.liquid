{%- assign sst = section.settings -%}
{%- assign product_limit = sst.limit -%}
{%- assign collection = collections[sst.collection] -%}

{% style %}
  #shopify-section-{{ section.id }} .distance {
    padding-top: {{ sst.distance_top_xs }}px;
    padding-bottom: {{ sst.distance_bottom_xs }}px;
    {% if bg_color != blank or sst.bg_image != blank -%}
      background: {{ bg_color }}
      {% if sst.bg_image != blank %} url("{{ sst.bg_image | img_url: '1920x' }}") center{% endif %};
      background-size: cover;
    {% endif %}
  }
  @media(min-width: 768px) {
    #shopify-section-{{ section.id }} .distance {
      padding-top: {{ sst.distance_top_md }}px;
      padding-bottom: {{ sst.distance_bottom_md }}px;
    }
  }
  @media(min-width: 1200px) {
    #shopify-section-{{ section.id }} .distance {
      padding-top: {{ sst.distance_top_xl }}px;
      padding-bottom: {{ sst.distance_bottom_xl }}px;
    }
  }
  #shopify-section-{{ section.id }}
  .block-newsletter-right {
    {% if sst.bg_newsletter != blank %}
      background-image: url("{{ sst.bg_newsletter | img_url: '1920x' }}");
      background-position: center center;
      background-size: cover;
    {% endif %}
  }
   #shopify-section-{{ section.id }} .block-newsletter-right .block-newsletter-content .block_title .heading{
      color: {{ sst.heading_color_right }};
   }
   #shopify-section-{{ section.id }} .block-newsletter-right .block-newsletter-content .block_title .sub_heading{
      color: {{ sst.sub_heading_color_right }};
   }

{% endstyle %}

<div
  class="distance position-relative color-{{ sst.color_section }}{% if sst.class != blank %} {{ sst.class }}{% endif %}{% if sst.animate %} wow fadeInUp animated{% endif %}"
  data-section-id="{{ section.id }}"
  data-section-type="nov-slick">
  <div class="{{ sst.container }}">
    <div class="d-flex align-items-stretch block_content">
      <div class="block-product-left">
        <div class="title_section text-center">
          {% if section.settings.heading_left != blank %}
            <h2 class="title" style="color: {{ section.settings.heading_color_left }}">{{ section.settings.heading_left }}</h2>
          {% endif %}
          {% if section.settings.sub_heading_left != blank %}
            <div class="sub_title" style="color: {{ section.settings.sub_heading_color }}">{{ section.settings.sub_heading_left }}</div>
          {% endif %}
        </div>
        <div
          class="list--view-items nov-slick-carousel row spacing-{{ sst.spacing }} spacing-sm-15"
          data-autoplay="false"
          data-autoplayTimeout="6000"
          data-loop="false"
          data-dots="{{ sst.show_dots }}"
          data-nav="{{ sst.show_nav }}"
          data-row="{{ sst.row_number }}"
          data-row_mobile="{{ sst.row_mobile }}"
          data-items_xxl="{{ sst.xxl }}"
          data-items="{{ sst.xl }}"
          data-items_lg="{{ sst.lg }}"
          data-items_md="{{ sst.md }}"
          data-items_sm="{{ sst.sm }}"
          data-items_xs="{{ sst.xs }}"
          {% if sst.show_nav %}
          data-custnav{% endif %}>
          {% for product in collection.products limit: product_limit %}
            {% if sectionId == blank %}
              {% assign sectionId = section.id %}
            {% endif %}
            <div class="block">
              <div>
                <div class="item sp-item">
                  {% render 'product-grid-item-style-3'
                    , product: product
                    , sectionId: sectionId %}
                </div>
              </div>
            </div>
          {% else %}
            {%- for i in (1..6) -%}
              {%- capture current -%}{% cycle 1, 2, 3, 4 %}{%- endcapture -%}
              <div class="sp-item mb-30">
                {{ 'product-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endfor -%}
          {% endfor %}
        </div>
      </div>
      <div class="block-newsletter-right">
        <div class="block-newsletter-content">
          <div class="block_title">
            <span class="heading">{{ sst.heading_right }}</span>
            <span class="sub_heading">{{ sst.sub_heading_right }}</span>
          </div>
          {% form 'customer'
            , id: 'section-contact' %}
            {{ form.errors | default_errors }}
            {% if form.posted_successfully? %}
              <p class="form--success text-center font-700">{{ 'general.newsletter_form.confirmation' | t }}</p>
            {% else %}
              <div class="input-group">
                <input
                  type="hidden"
                  name="contact[tags]"
                  value="newsletter">
                <input
                  type="email"
                  name="contact[email]"
                  class="form-control input"
                  value="{% if customer %}{{ customer.email }}{% endif %}"
                  placeholder="{{ 'general.newsletter_form.email_newsletter' | t }}"
                  required>
                <button
                  type="submit"
                  class="newsletter__submit btn"
                  name="commit"
                  title="{{ 'general.newsletter_form.submit' | t }}">
                  {{ 'general.newsletter_form.submit' | t }}
                </button>
              </div>
            {% endif %}
          {% endform %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Vinova Product Newsletter",
    "class": "section-product-newsletter",
    "settings": [
      {
        "type": "header",
        "content": "Block Product Left",
        "info": "Block Product Left"
      },
      {
        "type": "inline_richtext",
        "id": "heading_left",
        "label": "Heading",
        "default": "Lorem Ipsum"
      },
      {
        "type": "color",
        "id": "heading_color_left",
        "label": "Heading Color",
        "default": "#000000"
      },
      {
        "type": "inline_richtext",
        "id": "sub_heading_left",
        "label": "Sub Heading",
        "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit."
      },
      {
        "type": "color",
        "id": "sub_heading_color",
        "label": "Sub Heading Color",
        "default": "#8A8A8A"
      },
      {
        "type": "collection",
        "id": "collection",
        "label": "Collection Product"
      },
      {
        "type": "header",
        "content": "Product item per row"
      },
      {
        "type": "range",
        "id": "xxl",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Desktop",
        "default": 3,
        "info": "Breakpoint 1440px"
      },
      {
        "type": "range",
        "id": "xl",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Large laptop",
        "default": 3,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "range",
        "id": "lg",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Laptop",
        "default": 2,
        "info": "Breakpoint 992px"
      },
      {
        "type": "range",
        "id": "md",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Tablet",
        "default": 2,
        "info": "Breakpoint 768px"
      },
      {
        "type": "range",
        "id": "sm",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Large mobile",
        "default": 2,
        "info": "Breakpoint 576px"
      },
      {
        "type": "range",
        "id": "xs",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Mobile",
        "default": 2,
        "info": "Breakpoint"
      },
      {
        "type": "header",
        "content": "Slider options"
      },
      {
        "type": "range",
        "id": "limit",
        "min": 4,
        "max": 30,
        "step": 1,
        "label": "Limit",
        "default": 12,
        "info": "Select number limit products"
      },
      {
        "type": "range",
        "id": "row_number",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Number row",
        "default": 1
      },
      {
        "type": "range",
        "id": "row_mobile",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Number row mobile",
        "default": 1
      },
      {
        "type": "range",
        "id": "spacing",
        "min": 0,
        "max": 70,
        "step": 5,
        "unit": "px",
        "label": "Spacing",
        "default": 30,
        "info": "Spacing item"
      },
      {
        "type": "checkbox",
        "id": "show_nav",
        "label": "Show navigation",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "show_dots",
        "label": "Show dots",
        "default": false
      },
      {
        "type": "header",
        "content": "Block Newsletter Right",
        "info": "Block Newsletter Right"
      },
      {
        "type": "inline_richtext",
        "id": "heading_right",
        "label": "Heading",
        "default": "SUBSCRIBLE TO"
      },
      {
        "type": "color",
        "id": "heading_color_right",
        "label": "Heading Color",
        "default": "#000000"
      },
      {
        "type": "inline_richtext",
        "id": "sub_heading_right",
        "label": "Sub Heading",
        "default": "GET 60% DISCOUNT"
      },
      {
        "type": "color",
        "id": "sub_heading_color_right",
        "label": "Heading Color",
        "default": "#FFA500"
      },
      {
        "type": "image_picker",
        "id": "bg_newsletter",
        "label": "Background Image Newsletter"
      },
      {
        "type": "header",
        "content": "Design Option"
      },
      {
        "type": "checkbox",
        "id": "animate",
        "label": "Show animated",
        "default": true
      },
      {
        "type": "select",
        "id": "container",
        "label": "Container",
        "default": "container",
        "options": [
          {
            "value": "container",
            "label": "Container"
          },
          {
            "value": "container-fluid",
            "label": "Container fluid"
          },
          {
            "value": "container-full",
            "label": "Container full width"
          }
        ]
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Background Colors",
        "default": "#ffffff"
      },
      {
        "type": "image_picker",
        "id": "bg_image",
        "label": "Background Image"
      },
      {
        "type": "text",
        "id": "class",
        "label": "Class"
      },
      {
        "type": "header",
        "content": "Spacing top (px)"
      },
      {
        "type": "number",
        "id": "distance_top_xl",
        "label": "Large laptop",
        "default": 30,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "distance_top_md",
        "label": "Tablet",
        "default": 30,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "distance_top_xs",
        "label": "Mobile",
        "default": 30
      },
      {
        "type": "header",
        "content": "Spacing bottom (px)"
      },
      {
        "type": "number",
        "id": "distance_bottom_xl",
        "label": "Large laptop",
        "default": 30,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "distance_bottom_md",
        "label": "Tablet",
        "default": 30,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "distance_bottom_xs",
        "label": "Mobile",
        "default": 30
      }
    ],
    "presets": [
      {
        "name": "Vinova Product Newsletter"
      }
    ]

  }
{% endschema %}
