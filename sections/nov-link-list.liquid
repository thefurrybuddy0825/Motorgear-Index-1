{% assign sst = section.settings %}
<div
  class="distance{% if sst.class != blank %} {{ sst.class }}{% endif %}{% if sst.animate == true %} wow fadeInUp animated{% endif %}"
  data-section-id="{{ section.id }}"
  data-section-type="nov-slick"
>
  <div class="{{ sst.container }}">
    {% render 'heading-section', class: 'mb-23' %}

    <div
      class="row nov-slick-carousel"
      data-autoplay="false"
      data-autoplayTimeout="6000"
      data-loop="false"
      data-nav="false"
      data-items="{{ sst.grid_number }}"
      data-items_lg="{{ sst.grid_number_lg }}"
      data-items_md="{{ sst.grid_number_md }}"
      data-items_sm="{{ sst.grid_number_sm }}"
      data-items_xs="{{ sst.grid_number_xs }}"
      data-unslick="true"
    >
      {% for block in section.blocks %}
        {% assign bst = block.settings %}
        {% assign collection = collections[bst.collection] %}
        {% assign link_url = collection.url | default: '#' %}

        <div class="col">
          <div class="block_content text-center">
            <div class="b_img position-relative{% if bst.image_h != blank %} h_img_h{% else %} n_img_h{% endif %}">
              <a
                href="{{ link_url }}"
                class="d-block"
                aria-label="{{ bst.title | default: collection.title | escape }}"
              >
                {% if bst.image != blank %}
                  <img
                    class="img d-inline-block"
                    src="{{ bst.image | img_url: '200x' }}"
                    alt="{{ bst.title | default: collection.title | escape }}"
                    loading="lazy"
                    width="200"
                    height="200"
                  >
                {% else %}
                  {%- capture current -%}{% cycle 1, 2, 3, 4 %}{%- endcapture -%}
                  {{ 'collection-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}

                {% if bst.image_h != blank %}
                  <img
                    class="img_h"
                    src="{{ bst.image_h | img_url: '200x' }}"
                    alt="{{ bst.title | default: collection.title | escape }}"
                    loading="lazy"
                    width="200"
                    height="200"
                  >
                {% endif %}

                {% if sst.icon_h != blank %}
                  <img
                    class="icon_h"
                    src="{{ sst.icon_h | img_url: '50x' }}"
                    alt=""
                    loading="lazy"
                    width="50"
                    height="50"
                  >
                {% endif %}
              </a>
            </div>

            <a href="{{ link_url }}" class="name_item d-block position-relative font-700 mt-15">
              {{ bst.title | default: collection.title | escape }}
            </a>
          </div>
        </div>
      {% endfor %}
    </div>

    {% if section.blocks.size == 0 %}
      {% render 'no-blocks' %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Vinova Link List",
  "class": "section-link-list",
  "max_blocks": 12,
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Vinova Link List</p>"
    },
    {
      "type": "color",
      "id": "heading_c",
      "label": "Heading color",
      "default": "#222222"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Sub heading",
      "default": "<p>Subtitle from happy customers</p>"
    },
    {
      "type": "color",
      "id": "subheading_c",
      "label": "Sub heading color",
      "default": "#666666"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "text-left",
      "options": [
        { "value": "text-left", "label": "Left" },
        { "value": "text-center", "label": "Center" },
        { "value": "text-right", "label": "Right" }
      ]
    },
    { "type": "header", "content": "Item style" },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Border radius image",
      "default": 0,
      "info": "========================"
    },
    {
      "type": "color",
      "id": "color_link",
      "label": "Link text colors",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "color_link_h",
      "label": "Link text colors hover",
      "default": "#222222"
    },
    {
      "type": "range",
      "id": "fz_link",
      "min": 13,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Link font size",
      "default": 16
    },
    {
      "type": "color",
      "id": "text_c",
      "label": "Color text",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "fz_text",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Text font size",
      "default": 13,
      "info": "========================"
    },
    {
      "type": "color",
      "id": "background_i",
      "label": "Background item",
      "default": "#f3f3f3"
    },
    {
      "type": "color",
      "id": "background_i_h",
      "label": "Background item hover",
      "default": "#f3f3f3"
    },
    {
      "type": "image_picker",
      "id": "icon_h",
      "label": "Icon when hover image",
      "info": "50 x 50px recommended"
    },
    { "type": "header", "content": "Item per row" },
    {
      "type": "range",
      "id": "grid_number",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Large desktop",
      "default": 3,
      "info": "Breakpoint 1200px ↑"
    },
    {
      "type": "range",
      "id": "grid_number_lg",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Desktop",
      "default": 3,
      "info": "Breakpoint 992px ↑"
    },
    {
      "type": "range",
      "id": "grid_number_md",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Tablet",
      "default": 3,
      "info": "Breakpoint 768px ↑"
    },
    {
      "type": "range",
      "id": "grid_number_sm",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Large mobile",
      "default": 2,
      "info": "Breakpoint 576px ↑"
    },
    {
      "type": "range",
      "id": "grid_number_xs",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Mobile",
      "default": 1,
      "info": "Breakpoint 575px ↓"
    },
    { "type": "header", "content": "Design Option" },
    {
      "type": "select",
      "id": "container",
      "label": "Container",
      "default": "container",
      "options": [
        { "value": "container", "label": "Container" },
        { "value": "container-fluid", "label": "Container fluid" },
        { "value": "container-full", "label": "Container full width" }
      ]
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Colors",
      "default": "#ffffff"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "class",
      "label": "Class"
    },
    {
      "type": "number",
      "id": "distance_top",
      "label": "Top spacing section (px)",
      "default": 30
    },
    {
      "type": "number",
      "id": "distance_bottom",
      "label": "Bottom spacing section (px)",
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Enable entrance animation",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "featured_collection",
      "name": "Link",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "190 x 190px recommended" },
        { "type": "image_picker", "id": "image_h", "label": "Image hover", "info": "190 x 190px recommended" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vinova Link List",
      "category": "Collection",
      "blocks": [
        { "type": "featured_collection", "settings": { "collection": "frontpage" } },
        { "type": "featured_collection", "settings": { "collection": "frontpage" } },
        { "type": "featured_collection", "settings": { "collection": "frontpage" } }
      ]
    }
  ]
}
{% endschema %}

<style>
  {%- assign bg_image = sst.background_image -%}
  #shopify-section-{{ section.id }} .distance {
    padding-top: {{ sst.distance_top }}px;
    padding-bottom: {{ sst.distance_bottom }}px;
    {% if sst.background_color != blank %}
      background-color: {{ sst.background_color }};
    {% endif %}
    {% if bg_image.src != blank %}
      background-image: url("{{ bg_image | img_url: '1920x' }}");
      background-repeat: no-repeat;
      background-position: center top;
    {% endif %}
  }
  #shopify-section-{{ section.id }} .b_img {
    background: {{ sst.background_i }};
  }
  #shopify-section-{{ section.id }} .b_img:hover {
    background: {{ sst.background_i_h }};
  }
  #shopify-section-{{ section.id }} .name_item {
    color: {{ sst.color_link }};
    font-size: {{ sst.fz_link | divided_by: 10.0 | append: 'rem'}};
  }
  #shopify-section-{{ section.id }} .name_item:hover {
    color: {{ sst.color_link_h }};
  }
  #shopify-section-{{ section.id }} .sub_text {
    color: {{ sst.text_c }};
    font-size: {{ sst.fz_text | divided_by: 10.0 | append: 'rem' }};
  }
  #shopify-section-{{ section.id }} .b_img,
  #shopify-section-{{ section.id }} .n_img_h a:before {
    border-radius: {{ sst.border_radius }}%;
    overflow: hidden;
  }
  @media (max-width: 575px) {
    #shopify-section-{{ section.id }} .distance {
      padding-top: {{ sst.distance_top | times: 0.7 | round: 0 }}px;
      padding-bottom: {{ sst.distance_bottom | times: 0.7 | round: 0 }}px;
    }
    #shopify-section-{{ section.id }} .name_item {
      font-size: clamp(12px, {{ sst.fz_link | divided_by: 10.0 | append: 'rem'}}, 16px);
    }
  }
</style>
