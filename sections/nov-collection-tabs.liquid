    ],
    "presets": [
      {
        "name": "Vinova Collection Tabs",
        "category": "Collection",
        "blocks": [
          {
            "type": "tabitem",
            "settings": {
              "tab_title": "Tab one",
              "collection_handle": "frontpage"
            }
          },
          {
            "type": "tabitem",
            "settings": {
              "tab_title": "Tab Two",
