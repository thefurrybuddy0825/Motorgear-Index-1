        "default": "#fff"
      },
      {
        "type": "header",
        "content": "Design option"
      },
      {
        "type": "checkbox",
        "id": "view_all",
        "label": "Show button view all",
        "default": true
      },
      {
        "type": "select",
        "id": "btn_type",
        "label": "Button type",
