{%- assign sst = section.settings -%}
{%- assign collection = collections[sst.collection] -%}
{%- assign product_limit = sst.limit -%}
{%- assign bg_image = sst.background_image -%}
{% style %}
  #shopify-section-{{ section.id }} .distance {
    padding-top: {{ sst.distance_top_xs }}px;
    padding-bottom: {{ sst.distance_bottom_xs }}px;
    {% if sst.background_color != blank or bg_image != blank %}
      background: {{ sst.background_color }}
      {% if bg_image != blank %} url("{{ bg_image | img_url: '' }}"){% endif %}
    center;
      background-size: cover;
    {% endif %}
  }
  @media(min-width: 768px) {
    #shopify-section-{{ section.id }} .distance {
      padding-top: {{ sst.distance_top_md }}px;
      padding-bottom: {{ sst.distance_bottom_md }}px;
    }
  }
  @media(min-width: 1200px) {
    #shopify-section-{{ section.id }} .distance {
      padding-top: {{ sst.distance_top_xl }}px;
      padding-bottom: {{ sst.distance_bottom_xl }}px;
    }
  }
{% endstyle %}
<div
  class="distance position-relative color-{{ sst.color_section }}{% if sst.class != blank %} {{ sst.class }}{% endif %}{% if sst.animate %} wow fadeInUp animated{% endif %}"
  data-section-id="{{ section.id }}"
  data-section-type="nov-slick">
  <div class="{{ sst.container }}">
    {% if sst.show_nav %}
      <div class="d-flex align-items-center mb-52 mb-sm-32">
        {% render 'heading-section' class: 'mb-0' %}
        <div class="block-nav d-md-flex align-items-center d-none">
          <div class="nav-slider nav-prev">{% render 'icon-arrow-prev' %}</div>
          <div class="nav-slider nav-next">{% render 'icon-arrow-next' %}</div>
        </div>
      </div>
    {% else %}
      {% render 'heading-section' %}
    {% endif %}
    {% comment %} product slider {% endcomment %}
    <div
      class="grid--view-items nov-slick-carousel row spacing-{{ sst.spacing }} spacing-xxl-30"
      data-autoplay="false"
      data-autoplayTimeout="6000"
      data-loop="false"
      data-dots="{{ sst.show_dots }}"
      data-nav="{{ sst.show_nav }}"
      data-row="{{ sst.row_number }}"
      data-row_mobile="{{ sst.row_mobile }}"
      data-items_xxl="{{ sst.xxl }}"
      data-items="{{ sst.xl }}"
      data-items_lg="{{ sst.lg }}"
      data-items_md="{{ sst.md }}"
      data-items_sm="{{ sst.sm }}"
      data-items_xs="{{ sst.xs }}"
      {% if sst.show_nav %}
      data-custnav{% endif %}>
      {% for product in collection.products limit: product_limit %}
        {% if sectionId == blank %}
          {% assign sectionId = section.id %}
        {% endif %}
        <div class="block">
          <div>
            <div class="item sp-item {%- render 'number-to-col' -%}">
              {% render 'product-grid-item-style-1'
                , product: product
                , sectionId: sectionId %}
            </div>
          </div>
        </div>
      {% else %}
        {%- for i in (1..6) -%}
          {%- capture current -%}{% cycle 1, 2, 3, 4 %}{%- endcapture -%}
          <div class="sp-item mb-30">
            {{ 'product-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endfor -%}
      {% endfor %}
    </div>
    {% comment %} end product slider {% endcomment %}
    {% if sst.viewall %}
      <div class="text-center">
        <a href="{{ collection.url }}" class="btn {{ sst.btn_type }} {{ sst.btn_size }} mt-50 mt-sm-20">{{ 'sections.button.view_all' | t }}</a>
      </div>
    {% endif %}
  </div>
</div>
{% schema %}
  {
    "name": "Vinova Products Slider",
    "class": "section-product-slider",
    "settings": [
      {
        "type": "inline_richtext",
        "id": "heading",
        "label": "Heading",
        "default": "Vinova Product Slider"
      },
      {
        "type": "color",
        "id": "heading_color",
        "label": "Heading color",
        "default": "#222222"
      },
      {
        "type": "inline_richtext",
        "id": "subheading",
        "label": "Sub heading",
        "default": "Subtitle from happy customers"
      },
      {
        "type": "color",
        "id": "subheading_color",
        "label": "Sub heading color",
        "default": "#666666"
      },
      {
        "type": "select",
        "id": "heading_alignment",
        "label": "Heading alignment",
        "default": "text-left",
        "options": [
          {
            "value": "text-left",
            "label": "Left"
          },
          {
            "value": "text-center",
            "label": "Center"
          },
          {
            "value": "text-right",
            "label": "Right"
          }
        ]
      },
      {
        "type": "header",
        "content": "Block product"
      },
      {
        "type": "collection",
        "id": "collection",
        "label": "Collection"
      },
      {
        "type": "checkbox",
        "id": "viewall",
        "label": "Show view all"
      },
      {
        "type": "select",
        "id": "btn_type",
        "label": "Button type",
        "default": "btn-primary",
        "options": [
          {
            "value": "btn-primary",
            "label": "Primary"
          },
          {
            "value": "btn-secondary",
            "label": "Secondary"
          }
        ]
      },
      {
        "type": "select",
        "id": "btn_size",
        "label": "Button size",
        "default": "btn-normal",
        "options": [
          {
            "value": "btn-normal",
            "label": "Normal"
          },
          {
            "value": "btn-medium",
            "label": "Medium"
          },
          {
            "value": "btn-large",
            "label": "Large"
          }
        ]
      },
      {
        "type": "header",
        "content": "Product item per row"
      },
      {
        "type": "range",
        "id": "xxl",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Desktop",
        "default": 4,
        "info": "Breakpoint 1440px"
      },
      {
        "type": "range",
        "id": "xl",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Large laptop",
        "default": 4,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "range",
        "id": "lg",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Laptop",
        "default": 4,
        "info": "Breakpoint 992px"
      },
      {
        "type": "range",
        "id": "md",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Tablet",
        "default": 3,
        "info": "Breakpoint 768px"
      },
      {
        "type": "range",
        "id": "sm",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Large mobile",
        "default": 2,
        "info": "Breakpoint 576px"
      },
      {
        "type": "range",
        "id": "xs",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Mobile",
        "default": 2,
        "info": "Breakpoint"
      },
      {
        "type": "header",
        "content": "Slider options"
      },
      {
        "type": "range",
        "id": "limit",
        "min": 4,
        "max": 30,
        "step": 1,
        "label": "Limit",
        "default": 30,
        "info": "Select number limit products"
      },
      {
        "type": "range",
        "id": "row_number",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Number row",
        "default": 1
      },
      {
        "type": "range",
        "id": "row_mobile",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Number row mobile",
        "default": 1
      },
      {
        "type": "range",
        "id": "spacing",
        "min": 0,
        "max": 70,
        "step": 5,
        "unit": "px",
        "label": "Spacing",
        "default": 30,
        "info": "Spacing item"
      },
      {
        "type": "checkbox",
        "id": "show_nav",
        "label": "Show navigation",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "show_dots",
        "label": "Show dots",
        "default": false
      },
      {
        "type": "header",
        "content": "Design option"
      },
      {
        "type": "checkbox",
        "id": "animate",
        "label": "Show animated",
        "default": true
      },
      {
        "type": "select",
        "id": "container",
        "label": "Container",
        "default": "container",
        "options": [
          {
            "value": "container",
            "label": "Container"
          },
          {
            "value": "container-fluid",
            "label": "Container fluid"
          },
          {
            "value": "container-full",
            "label": "Container full width"
          }
        ]
      },
      {
        "type": "color_scheme",
        "id": "color_section",
        "label": "Color section",
        "default": "background-1"
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Background colors"
      },
      {
        "type": "image_picker",
        "id": "background_image",
        "label": "Background image"
      },
      {
        "type": "text",
        "id": "class",
        "label": "Class"
      },
      {
        "type": "header",
        "content": "Spacing top (px)"
      },
      {
        "type": "number",
        "id": "distance_top_xl",
        "label": "Large laptop",
        "default": 30,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "distance_top_md",
        "label": "Tablet",
        "default": 30,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "distance_top_xs",
        "label": "Mobile",
        "default": 30
      },
      {
        "type": "header",
        "content": "Spacing bottom (px)"
      },
      {
        "type": "number",
        "id": "distance_bottom_xl",
        "label": "Large laptop",
        "default": 30,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "distance_bottom_md",
        "label": "Tablet",
        "default": 30,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "distance_bottom_xs",
        "label": "Mobile",
        "default": 30
      }
    ],
    "presets": [
      {
        "name": "Vinova Products Slider"
      }
    ]
  }
{% endschema %}
