            "type": "text",
            "id": "btn",
            "label": "Button"
          },
          {
            "type": "url",
            "id": "btn_l",
            "label": "Button link"
          },
          {
            "type":  "header",
            "content": "Pin List"
          },
          {
            "type":  "header",
            "content": "Pin 1"
          },
          {
            "type": "text",
            "id": "pin_position_1",
            "label": "Pin position 1",
            "info": "Example: Top: 50%; Left: 20%",
            "default": "Top: 50%; Left: 20%"
          },
          {
            "type": "product",
            "id": "pin_product_1",
            "label": "Select Pin Product 1"
          },
          {
            "type":  "header",
            "content": "Pin 2"
          },
          {
            "type": "text",
            "id": "pin_position_2",
            "label": "Pin position 2",
            "info": "Example: Top: 50%; Left: 20%",
            "default": "Top: 50%; Left: 20%"
          },
          {
            "type": "product",
            "id": "pin_product_2",
            "label": "Select Pin Product 2"
          },
          {
            "type":  "header",
            "content": "Pin 3"
          },
          {
            "type": "text",
            "id": "pin_position_3",
            "label": "Pin position 3",
            "info": "Example: Top: 50%; Left: 20%",
            "default": "Top: 50%; Left: 20%"
          },
          {
            "type": "product",
            "id": "pin_product_3",
