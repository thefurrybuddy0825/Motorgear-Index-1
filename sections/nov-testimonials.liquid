{%- assign sst = section.settings -%}
{%- assign bg_image = sst.background_image -%}
{% style %}
  #shopify-section-{{ section.id }} .distance {
    padding-top: {{ sst.distance_top_xs }}px;
    padding-bottom: {{ sst.distance_bottom_xs }}px;
    {% if sst.background_color != blank or bg_image != blank %}
      background: {{ sst.background_color }}
      {% if bg_image != blank %} url("{{ bg_image | img_url: '' }}"){% endif %}
    no-repeat center;
      background-size: cover;
    {% endif %}
  }
  @media(min-width: 768px) {
    #shopify-section-{{ section.id }} .distance {
      padding-top: {{ sst.distance_top_md }}px;
      padding-bottom: {{ sst.distance_bottom_md }}px;
    }
  }
  @media(min-width: 1200px) {
    #shopify-section-{{ section.id }} .distance {
      padding-top: {{ sst.distance_top_xl }}px;
      padding-bottom: {{ sst.distance_bottom_xl }}px;
    }
  }
  #shopify-section-{{ section.id }}
  .testimonial-rating .rating{
    color: {{ sst.rating_color }};
  }
  #shopify-section-{{ section.id }} .testimonial-item__quote{
    color: {{ sst.icon_color }};
  }
  {% if sst.text_mw != blank %}
    #shopify-section-{{ section.id }}
    .testimonial-item__quote {
      max-width: {{ sst.text_mw }}px;
    }
  {% endif %}
{% endstyle %}

<div
  class="distance color-{{ sst.color_section }}{% if sst.class != blank %} {{ sst.class }}{% endif %} position-relative{% if sst.animate %} wow fadeInUp animated{% endif %}"
  data-section-id="{{ section.id }}"
  data-section-type="nov-slick">
  <div class="{{ sst.container }}">
    {% render 'heading-section' %}
    {% if section.blocks.size > 0 %}
      <div
        class="nov-slick-carousel row spacing-{{ sst.spacing }} spacing-sm-15"
        data-autoplay="false"
        data-autoplayTimeout="6000"
        data-loop="false"
        data-dots="{{ sst.show_dots }}"
        data-nav="false"
        data-items="{{ sst.xl }}"
        data-items_lg="{{ sst.lg }}"
        data-items_md="{{ sst.md }}"
        data-items_sm="{{ sst.sm }}"
        data-items_xs="{{ sst.xs }}"
        data-row="1">
        {% for block in section.blocks %}
          {%- liquid
            assign bst = block.settings
            case bst.star
              when 1
                assign ns = '<i class="rating"></i><i></i><i></i><i></i><i></i>'
              when 2
                assign ns = '<i class="rating"></i><i class="rating"></i><i></i><i></i><i></i>'
              when 3
                assign ns = '<i class="rating"></i><i class="rating"></i><i class="rating"></i><i></i><i></i>'
              when 4
                assign ns = '<i class="rating"></i><i class="rating"></i><i class="rating"></i><i class="rating"></i><i></i>'
              when 5
                assign ns = '<i class="rating"></i><i class="rating"></i><i class="rating"></i><i class="rating"></i><i class="rating"></i>'
            endcase
          -%}
          <div class="testimonial-item sp-item{% render 'number-to-col' %}">
            <div class="item-content d-flex align-items-center justify-content-center text-center position-relative">
              <div class="block-left">
                {% if bst.bg_image_avatar != blank %}
                  {%- assign imagealt = bst.bg_image_avatar.alt | default: "testimonial-image" | strip_html | escape -%}
                  {{ bst.bg_image_avatar | image_url: width: 1500 | image_tag: loading: 'lazy', alt: imagealt, class: 'img-fluid', widths: '300 400 500 768 1200 1500'
                  }}
                {% else %}
                  {%- capture current -%}{% cycle 1, 2, 3, 4 %}{%- endcapture -%}
                  {{ 'collection-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg' | replace: '<svg', '<svg style="width: 233px; height: 242px;"' }}
                {% endif %}
                {% if sst.show_avatar %}
                  <div class="testimonial-avatar overflow_hidden d-inline-block">
                    {% if bst.avatar != blank %}
                      {%- assign imagealt = bst.avatar.alt | default: "testimonial-image" | strip_html | escape -%}
                      {{ bst.avatar | image_url: width: 768 | image_tag: loading: 'lazy', alt: imagealt, class: 'img-fluid', widths: '200 250 300 400 500 768'
                      }}
                    {% else %}
                      {%- capture current -%}{% cycle 1, 2, 3, 4 %}{%- endcapture -%}
                      {{ 'product-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg' | replace: '<svg', '<svg style="width: 133px; height: 133px; border-radius: 100%;"' }}
                    {% endif %}
                  </div>
                {% endif %}
              </div>
              <div class="block-right">
                {% if bst.name != blank %}
                  <div class="testimonial-name mb-5">{{ bst.name }}</div>
                {% endif %}
                {% if bst.info != blank %}
                  <div class="testimonial-info mb-5">{{ bst.info }}</div>
                {% endif %}
                {% if sst.s_star %}
                  <div class="testimonial-rating mb-16">{{ ns }}</div>
                {% endif %}
                {% if sst.show_icon %}
                  <div class="icon-quote mb-14">
                    {% render 'icon-quote'
                      , fill: sst.icon_color %}
                  </div>
                {% endif %}
                {% if bst.quote != blank %}
                  <div class="testimonial-item__quote line-clamp-3">{{ bst.quote }}</div>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% else %}
      {% render 'no-blocks' %}
    {% endif %}
  </div>
</div>

{% schema %}
  {
    "name": "Vinova Testimonials",
    "class": "section-testimonials",
    "settings": [
      {
        "type": "richtext",
        "id": "heading",
        "label": "Heading",
        "default": "<p>Vinova Testimonials</p>"
