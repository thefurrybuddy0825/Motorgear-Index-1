{%- assign sst = section.settings -%}
{%- assign collection_left = collections[sst.collection_left] -%}
{%- assign collection_right = collections[sst.collection_right] -%}
{%- assign product_limit = sst.limit_product_left -%}
{%- assign product_limit2 = sst.limit -%}
{%- assign label_best_choice = sst.label_best_choice -%}

{% style %}
  #shopify-section-{{ section.id }} .distance {
    padding-top: {{ sst.distance_top_xs }}px;
    padding-bottom: {{ sst.distance_bottom_xs }}px;
    {% if sst.bg_color != blank or sst.bg_image != blank -%}
      background: {{ bg_color }}
      {% if sst.bg_image != blank %} url("{{ sst.bg_image | img_url: '1920x' }}") center{% endif %};
      background-size: cover;
    {% endif %}
  }
  @media(min-width: 768px) {
    #shopify-section-{{ section.id }} .distance {
      padding-top: {{ sst.distance_top_md }}px;
      padding-bottom: {{ sst.distance_bottom_md }}px;
    }
  }
  @media(min-width: 1200px) {
    #shopify-section-{{ section.id }} .distance {
      padding-top: {{ sst.distance_top_xl }}px;
      padding-bottom: {{ sst.distance_bottom_xl }}px;
    }
  }
  #shopify-section-{{ section.id }}
  .block_product_left .product-style-special .product-top .product--badge-sp .badges {
    color: {{ sst.heading_color_left }};
    background-color: {{ sst.label_color }};
  }
{% endstyle %}
<div
  class="distance{% if sst.class != blank %} {{ sst.class }}{% endif %}{% if sst.animate %} wow fadeInUp animated{% endif %}"
  data-section-id="{{ section.id }}"
  data-section-type="nov-slick">
  <div class="{{ sst.container }}">
    <div class="block_content">
      <div class="block_product_left">
        <div class="heading_left title_section">
          <div class="block-nav d-flex align-items-center justify-content-center">
            <div class="nav-slider nav-prev">{% render 'icon-arrow-prev' %}</div>
            <div class="headding">
              <h2 class="title" style="color: {{ sst.heading_color_left }};">{{ sst.heading_left }}</h2>
            </div>
            <div class="nav-slider nav-next">{% render 'icon-arrow-next' %}</div>
          </div>
        </div>
        <div
          class="list--view-items nov-slick-carousel"
          data-autoplay="false"
          data-autoplayTimeout="6000"
          data-loop="false"
          data-dots="false"
          data-nav="false"
          data-row="1"
          data-row_mobile="1"
          data-items_xxl="1"
          data-items="1"
          data-items_lg="1"
          data-items_md="1"
          data-items_sm="1"
          data-items_xs="1"
          data-custnav>
          {% for product in collection_left.products limit: product_limit %}
            {% if sectionId == blank %}
              {% assign sectionId = section.id %}
            {% endif %}
            <div class="item">
              {% render 'product-grid-item-special'
                , product: product
                , sectionId: sectionId
                , label_best_choice: label_best_choice %}
            </div>
          {% else %}
            {%- for i in (1..4) -%}
              {%- capture current -%}{% cycle 1, 2, 3, 4 %}{%- endcapture -%}
              <div class="sp-item mb-30">
                {{ 'product-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg' | replace: '<svg', '<svg style=" height: 720px; border-radius: 10px;"' }}
              </div>
            {%- endfor -%}
          {% endfor %}
        </div>
      </div>
      <div class="block_porduct_right">
        <div class="heading_right title_section">
          <h2 class="title" style="color: {{ sst.heading_color_right }};">{{ sst.heading_right }}</h2>
        </div>
        {% if collection_right.products != blank %}
          <div
            class="nov-slick-carousel2 row spacing-{{ sst.spacing }} spacing-sm-15 block_content_right"
            data-autoplay="false"
            data-autoplayTimeout="6000"
            data-loop="false"
            data-dots="false"
            data-nav="false"
            data-row="{{ sst.row_number }}"
            data-row_mobile="{{ sst.row_mobile }}"
            data-items_xxl="{{ sst.xxl }}"
            data-items="{{ sst.xl }}"
            data-items_lg="{{ sst.lg }}"
            data-items_md="{{ sst.md }}"
            data-items_sm="{{ sst.sm }}"
            data-items_xs="{{ sst.xs }}">
            {% for product in collection_right.products limit: product_limit2 %}
              {% if sectionId == blank %}
                {% assign sectionId = section.id %}
              {% endif %}
              <div class="item sp-item">
                {% render 'product-list-items-style'
                  , product: product
                  , sectionId: sectionId %}
              </div>
            {% endfor %}
          </div>
        {% else %}
          <div class="row  spacing-30  spacing-sm-15 block_content_right">
            {%- for i in (1..6) -%}
              {%- capture current -%}{% cycle 1, 2, 3, 4 %}{%- endcapture -%}
              <div class="item sp-item col-lg-6 mb-30">
                {{ 'product-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg' | replace: '<svg', '<svg style=" height: 220px; border-radius: 10px;"' }}
              </div>
            {%- endfor -%}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>


{% schema %}
  {
    "name": "Vinova Product Special",
    "class": "section-product-special",
    "settings": [
      {
        "type": "header",
        "content": "Block Product Left",
        "info": "Block Product Left"
      },
      {
        "type": "inline_richtext",
        "id": "heading_left",
        "label": "Heading",
        "default": "Lorem Ipsum"
      },
      {
        "type": "color",
        "id": "heading_color_left",
        "label": "Heading Color",
        "default": "#000000"
      },
      {
        "type": "collection",
        "id": "collection_left",
        "label": "Collection Product"
      },
      {
        "type": "inline_richtext",
        "id": "label_best_choice",
        "label": "Label For Product",
        "default": "Best Choice"
      },
      {
        "type": "color",
        "id": "label_color",
        "label": "Background Color Label",
        "default": "#FFA500"
      },
      {
        "type": "number",
        "id": "limit_product_left",
        "label": "Limit Product",
        "default": 4
      },
      {
        "type": "header",
        "content": "Block Product Right",
        "info": "Block Product Right"
      },
      {
        "type": "inline_richtext",
        "id": "heading_right",
        "label": "Heading",
        "default": "Lorem Ipsum"
      },
      {
        "type": "color",
        "id": "heading_color_right",
        "label": "Heading Color",
        "default": "#000000"
      },
      {
        "type": "collection",
        "id": "collection_right",
        "label": "Collection Product"
      },
      {
        "type": "header",
        "content": "Product item per row"
      },
      {
        "type": "range",
        "id": "xxl",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Desktop",
        "default": 3,
        "info": "Breakpoint 1440px"
      },
      {
        "type": "range",
        "id": "xl",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Large laptop",
        "default": 3,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "range",
        "id": "lg",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Laptop",
        "default": 2,
        "info": "Breakpoint 992px"
      },
      {
        "type": "range",
        "id": "md",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Tablet",
        "default": 2,
        "info": "Breakpoint 768px"
      },
      {
        "type": "range",
        "id": "sm",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Large mobile",
        "default": 2,
        "info": "Breakpoint 576px"
      },
      {
        "type": "range",
        "id": "xs",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Mobile",
        "default": 2,
        "info": "Breakpoint"
      },
      {
        "type": "header",
        "content": "Slider options"
      },
      {
        "type": "range",
        "id": "limit",
        "min": 4,
        "max": 30,
        "step": 1,
        "label": "Limit",
        "default": 12,
        "info": "Select number limit products"
      },
      {
        "type": "range",
        "id": "row_number",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Number row",
        "default": 3
      },
      {
        "type": "range",
        "id": "row_mobile",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Number row mobile",
        "default": 2
      },
      {
        "type": "range",
        "id": "spacing",
        "min": 0,
        "max": 70,
        "step": 5,
        "unit": "px",
        "label": "Spacing",
        "default": 30,
        "info": "Spacing item"
      },
      {
        "type": "header",
        "content": "Design Option"
      },
      {
        "type": "checkbox",
        "id": "animate",
        "label": "Show animated",
        "default": true
      },
      {
        "type": "select",
        "id": "container",
        "label": "Container",
        "default": "container",
        "options": [
          {
            "value": "container",
            "label": "Container"
          },
          {
            "value": "container-fluid",
            "label": "Container fluid"
          },
          {
            "value": "container-full",
            "label": "Container full width"
          }
        ]
      },
      {
        "type": "color",
        "id": "bg_color",
        "label": "Background Colors",
        "default": "#ffffff"
      },
      {
        "type": "image_picker",
        "id": "bg_image",
        "label": "Background Image"
      },
      {
        "type": "text",
        "id": "class",
        "label": "Class"
      },
      {
        "type": "header",
        "content": "Spacing top (px)"
      },
      {
        "type": "number",
        "id": "distance_top_xl",
        "label": "Large laptop",
        "default": 30,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "distance_top_md",
        "label": "Tablet",
        "default": 30,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "distance_top_xs",
        "label": "Mobile",
        "default": 30
      },
      {
        "type": "header",
        "content": "Spacing bottom (px)"
      },
      {
        "type": "number",
        "id": "distance_bottom_xl",
        "label": "Large laptop",
        "default": 30,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "distance_bottom_md",
        "label": "Tablet",
        "default": 30,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "distance_bottom_xs",
        "label": "Mobile",
        "default": 30
      }
    ],
    "presets": [
      {
        "name": "Vinova Prodcut Special"
      }
    ]

  }
{% endschema %}
