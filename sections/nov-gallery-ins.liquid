{%- assign sst = section.settings -%}
{% style %}
  #shopify-section-{{ section.id }} .distance {
    padding-top: {{ sst.distance_top_xs }}px;
    padding-bottom: {{ sst.distance_bottom_xs }}px;
    {% if sst.background_color != blank %}
      background-color: {{ sst.background_color }};
    {% endif %}
  }
  @media(min-width: 768px) {
    #shopify-section-{{ section.id }} .distance {
      padding-top: {{ sst.distance_top_md }}px;
      padding-bottom: {{ sst.distance_bottom_md }}px;
    }
  }
  @media(min-width: 1200px) {
    #shopify-section-{{ section.id }} .distance {
      padding-top: {{ sst.distance_top_xl }}px;
      padding-bottom: {{ sst.distance_bottom_xl }}px;
    }
  }
  #shopify-section-{{ section.id }} .card_gallery {
    border-radius: {{ sst.border_radius }}px;
  }
{% endstyle %}

<div class="distance{% if sst.class != blank %} {{ sst.class }}{% endif %}{% if sst.animate %} wow fadeInUp animated{% endif %}" data-section-id="{{ section.id }}" data-section-type="nov-slick">
  <div class="{{ sst.container }}">
    {% render 'heading-section' %}
    <div class="nov-slick-carousel row spacing-{{ sst.spacing }}"
      data-autoplay="{{ sst.autoplay }}"
      data-autoplaytimeout="{{ sst.autoplay_speed }}" 
      data-loop="true" 
      data-dots="false" 
      data-nav="{{ sst.show_nav }}" 
      data-items="{{ sst.lg }}" 
      data-items_md="{{ sst.md }}" 
      data-items_sm="{{ sst.sm }}" 
      data-items_xs="{{ sst.xs }}"
      {% if sst.one_slider == true %}data-oneslider="1"{% endif %}
      data-row="1">
      {% for block in section.blocks %}
        <div class="gallery--content sp-item{% render 'number-to-col' %}">
          <div class="card_gallery hover-image d-block overflow_hidden">
            <a href="{{ block.settings.image | img_url: '1200x' }}" class="d-block" data-fancybox="gallery">
              {% if block.settings.image != blank %}
                <img class="lazyload w-100" data-src="{{ block.settings.image | img_url: '600x600', crop: 'center' }}">
                <i class="fa fa-instagram" aria-hidden="true"></i>
              {% else %}
                {%- capture current -%}{% cycle 1, 2, 3, 4 %}{%- endcapture -%}
                {{ 'collection-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
            </a>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

