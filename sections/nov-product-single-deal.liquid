{%- assign sst = section.settings -%}
{% style %}
  {%- assign bg_image = sst.background_image -%}
  #shopify-section-{{ section.id }}
  .distance {
    padding-top: {{ sst.distance_top_xs }}px;
    padding-bottom: {{ sst.distance_bottom_xs }}px;
    {% if sst.background_color != blank %}
      background: {{ sst.background_color }};
      background-size: cover;
    {% endif %}
    {% if sst.show_border %}
      border: 1px solid{{ sst.border_color }};
    {% endif %}
  }
  @media(min-width: 768px) {
    #shopify-section-{{ section.id }} .distance {
      padding-top: {{ sst.distance_top_md }}px;
      padding-bottom: {{ sst.distance_bottom_md }}px;
    }
  }
  @media(min-width: 1200px) {
    #shopify-section-{{ section.id }} .distance {
      padding-top: {{ sst.distance_top_xl }}px;
      padding-bottom: {{ sst.distance_bottom_xl }}px;
    }
  }
  {% if sst.countdown_timeend != blank %}
    #shopify-section-{{ section.id }}
    .countdownfree .item-time {
      color: {{ sst.countdown_color }};
      border: 4px solid {{ sst.countdown_bg }};
    }
  {% endif %}
{% endstyle %}
<div class="distance position-relative{% if sst.class != blank %} {{ sst.class }}{% endif %}{% if sst.animate %}wow fadeInUp animated{% endif %}">
  <div class="{{ sst.container }}">
    {% render 'heading-section' %}
    <div class="product-single row no-gutters align-items-center position-relative">
      {%- assign product = all_products[sst.product_handle] -%}
      <div class="nov-product__single-info col-lg-6 col-12">
        {% if sst.title != blank %}
          <div class="title-deal text-uppercase">{{ sst.title }}</div>
        {% endif %}
        {% if product.title != blank %}
          <a href="{{ product.url | within: collection }}" class="product-single__title c_h hover:c_df font-700 f_pr d-inline-block">{{ product.title }}</a>
        {%  else %}
          <a href="#" class="product-single__title c_h hover:c_df font-700 f_pr d-inline-block"> Product title</a>
        {% endif %}

        {%-  liquid
          assign on_sale = false
          if product.compare_at_price_min > product.price_min
              assign on_sale = true
          endif
        -%}
        <div class="price-box">
          {% if on_sale %}
              <div class="price-sale">
                <span class="old-price" data-compare-price-grid>{{ product.variants[0].compare_at_price | money }}</span>
                <span class="special-price" data-price-grid>{{ product.variants[0].price | money }}</span>
              </div>
              {% else %}
                <div class="price-regular">
                    <span data-price-grid>{{ product.variants[0].price | money }}</span>
                </div>
              {% endif %}
          </div>
          <div class="product-single__desc">{{ product.description | strip_html | truncate: 180 }}</div>

        <a href="{{ product.url | within: collection | default: "#" }}" class="btn {{ sst.btn_type }} {{ sst.btn_size }} font-700">{{ sst.shop_now }}</a>
        {% if sst.countdown_timeend != blank %}
          <div
            class="countdownfree d-flex mt-56"
            data-countdown="{{ sst.countdown_timeend }}"
            data-show-days="{{ settings.show_day }}"
            data-restart="{{ settings.restart }}"></div>
        {% endif %}
      </div>
      <div class="nov-product__single-thumb col-lg-6 col-12">
        {% if sst.img_cover != blank %}
          {%- assign imagealt = sst.img_cover.alt | default: 'icon-text' | strip_html | escape -%}
              {{ sst.img_cover | image_url: width: 3840 | image_tag:
                loading: 'lazy',
                class: 'img-fluid',
                alt: imagealt,
                widths: '200, 320, 525, 768, 992, 1200, 1440, 1920, 2480, 3840'
              }}
        {% elsif product.featured_image != blank %}
          <div class="product-single__photos">
            {% assign img_url = product.featured_image %}
            {%- assign imagealts = img_url.alt | default: product.title | strip_html | escape -%}
            {{ img_url | image_url: width: 1920 | image_tag:
              loading: 'lazy',
              class: 'product__thumbnail img-fluid',
              alt: imagealts,
              widths: '200, 350, 525, 768, 992, 1200, 1440, 1920, 2480, 3840'
            }}
            {% for image in product.images %}
              {% assign img_url = image.src %}
              {% if forloop.first != true %}
              {{ img_url | image_url: width: 1920 | image_tag:
                  loading: 'lazy',
                  class: 'product__thumbnail-second img-fluid',
                  alt: imagealt,
                  widths: '200, 350, 525, 768, 992, 1200, 1440, 1920'
              }}
              {% break %}
              {% endif %}
            {% endfor %}
          </div>
        {% else %}
          {{ 'product-apparel-1' | append: current | placeholder_svg_tag: 'placeholder-svg' | replace: '<svg', '<svg style="width: 600px; height: 600px;"' }}
        {% endif %}
      </div>
    </div>
  </div>
</div>
{% schema %}
