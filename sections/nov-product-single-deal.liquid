      {
        "type": "header",
        "content": "Image cover"
      },
      {
        "type": "image_picker",
        "id": "img_cover",
        "label": "Image cover"
      },
      {
        "type": "header",
        "content": "Product"
      },
      {
        "type": "product",
        "id": "product_handle",
        "label": "Product"
      },
      {
        "type": "header",
