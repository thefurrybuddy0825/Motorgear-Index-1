{% assign sst = section.settings %}
{%- if settings.lang_iso_rtl != blank -%}
  {% assign list_iso_rtl = settings.lang_iso_rtl | downcase %}
  {% if list_iso_rtl contains request.locale.iso_code %}
    {% assign iso_rtl = true %}
  {% else %}
    {% assign iso_rtl = false %}
  {% endif %}
{%- endif -%}

{% style %}
    #shopify-section-{{ section.id }} .distance {
      padding-top: {{ sst.distance_top_xs }}px;
      padding-bottom: {{ sst.distance_bottom_xs }}px;
    }
    {% if sst.enable_mh %}
      @media(min-width:  2000px) {
        #shopify-section-{{ section.id }} .respone_image {
          max-height: {{ sst.mh }}px;
          padding-top: 0 !important;
        }
        #shopify-section-{{ section.id }} .image-entity {
          max-height: {{ sst.mh }}px;
          position: static;
        }
      }
    {% endif %}
    #shopify-section-{{ section.id }} .timer:before {
      animation-duration: {{ sst.autoplay_speed | divided_by: 1000 | append: 's' }};
      background-color: rgba({{ sst.bg_load | color_to_rgb | remove: 'rgb(' | remove: 'rgba(' | remove: ')' | remove: ', 0.0' }}, {{ sst.bg_load_opacity }}%);
    }
    #shopify-section-{{ section.id }} [data-slick-to]:before {
      background-color: rgba({{ sst.c_dot | color_to_rgb | remove: 'rgb(' | remove: 'rgba(' | remove: ')' | remove: ', 0.0' }}, {{ sst.c_dot_opacity }}%);
    }
    #shopify-section-{{ section.id }} [data-slick-to][current]:before,
    #shopify-section-{{ section.id }} [data-slick-to]:hover:before {
      background-color: {{ sst.c_dot_a }};
    }
    #shopify-section-{{ section.id }} [data-slick-to][current] svg circle {
      stroke: rgba({{ sst.bd_dot_a | color_to_rgb | remove: 'rgb(' | remove: 'rgba(' | remove: ')' | remove: ', 0.0' }}, {{ sst.bd_dot_opacity }}%);
      transition: all {{ sst.autoplay_speed | divided_by: 1000 | append: 's' }} linear;
    }
    {% if sst.progress_num %}
      #shopify-section-{{ section.id }} .progress-num .number_nav {
        color:  {{ sst.c_nbprogress_1 }};
      }
      #shopify-section-{{ section.id }} .progress-num .current_nav {
        color:  {{ sst.c_nbprogress_2 }};
      }
      #shopify-section-{{ section.id }} .progress-num .progress-slide {
        background-color: {{ sst.c_progress_1 }};
      }
      #shopify-section-{{ section.id }} .progress-num .progress-slide.active{
        background-color: {{ sst.c_progress_2 }};
        border-radius: 2px;
      }
    {% endif %}
    {% for block in section.blocks %}
      {% assign bst = block.settings %}
      #shopify-section-{{ section.id }} .content-{{ forloop.index }} {
          {% assign new_position = bst.position | downcase %}
          {% if settings.enable_rtl and iso_rtl %}
            {% if new_position contains 'left' %}
              {% assign new_position = new_position | replace: 'left', 'right' %}
            {% elsif new_position contains 'right' %}
              {% assign new_position = new_position | replace: 'right', 'left' %}
            {% endif %}
          {% endif %}
          {{ new_position }};
      }

      #shopify-section-{{ section.id }} .content-{{ forloop.index }} .caption-1 {
        font-size: {{ bst.fz_cap1_xxl }}px;
        letter-spacing: {{ bst.let1 }}px;
        margin-bottom: {{ bst.mb1 }}px;
        line-height: {{ bst.line_height1 }};
        -webkit-text-stroke: {{ bst.ts1_w }}px {{ bst.ts1_c }};
      }
      #shopify-section-{{ section.id }} .content-{{ forloop.index }} .caption-2 {
        font-size: {{ bst.fz_cap2_xxl }}px;
        letter-spacing: {{ bst.let2 }}px;
        margin-bottom: {{ bst.mb2 }}px;
        line-height: {{ bst.line_height2 }};
      }
      #shopify-section-{{ section.id }} .content-{{ forloop.index }} .caption-3 {
        font-size: {{ bst.fz_cap3_xxl }}px;
        letter-spacing: {{ bst.let3 }}px;
        margin-bottom: {{ bst.mb3 }}px;
        line-height: {{ bst.line_height3 }};
      }
      #shopify-section-{{ section.id }} .content-{{ forloop.index }} .caption-4 {
        font-size: {{ bst.fz_cap4_xxl }}px;
        letter-spacing: {{ bst.let4 }}px;
        margin-bottom: {{ bst.mb4 }}px;
        line-height: {{ bst.line_height4 }};
      }
      @media(max-width: 1599px) {

        #shopify-section-{{ section.id }} .content-{{ forloop.index }} {
          {% if settings.enable_rtl and iso_rtl %}{{ bst.position_xl | downcase | replace: 'left', 'right' }}{% else %}{{ bst.position_xl }}{% endif %};
        }
        #shopify-section-{{ section.id }} .content-{{ forloop.index }} .caption-1 {
          font-size: {{ bst.fz_cap1_xl }}px;
          margin-bottom: {{ bst.mb1_xl }}px;
        }
        #shopify-section-{{ section.id }} .content-{{ forloop.index }} .caption-2 {
          font-size: {{ bst.fz_cap2_xl }}px;
          margin-bottom: {{ bst.mb2_xl }}px;
        }
        #shopify-section-{{ section.id }} .content-{{ forloop.index }} .caption-3 {
          font-size: {{ bst.fz_cap3_xl }}px;
          margin-bottom: {{ bst.mb3_xl }}px;
        }
        #shopify-section-{{ section.id }} .content-{{ forloop.index }} .caption-4 {
          font-size: {{ bst.fz_cap4_xl }}px;
          margin-bottom: {{ bst.mb4_xl }}px;
        }
      }
      @media(max-width: 1199px) {

        #shopify-section-{{ section.id }} .content-{{ forloop.index }} {
          {% if settings.enable_rtl and iso_rtl %}{{ bst.position_lg | downcase | replace: 'left', 'right' }}{% else %}{{ bst.position_lg }}{% endif %};
        }
        #shopify-section-{{ section.id }} .content-{{ forloop.index }} .caption-1 {
          font-size: {{ bst.fz_cap1_lg }}px;
          margin-bottom: {{ bst.mb1_lg }}px;
        }
        #shopify-section-{{ section.id }} .content-{{ forloop.index }} .caption-2 {
          font-size: {{ bst.fz_cap2_lg }}px;
          margin-bottom: {{ bst.mb2_lg }}px;
        }
        #shopify-section-{{ section.id }} .content-{{ forloop.index }} .caption-3 {
          font-size: {{ bst.fz_cap3_lg }}px;
          margin-bottom: {{ bst.mb3_lg }}px;
        }
        #shopify-section-{{ section.id }} .content-{{ forloop.index }} .caption-4 {
          font-size: {{ bst.fz_cap4_xl }}px;
          margin-bottom: {{ bst.mb4_lg }}px;
        }
      }
      @media(max-width: 991px) {

        #shopify-section-{{ section.id }} .content-{{ forloop.index }} {
          {% if settings.enable_rtl and iso_rtl %}{{ bst.position_md | downcase | replace: 'left', 'right' }}{% else %}{{ bst.position_md }}{% endif %};
        }
        #shopify-section-{{ section.id }} .content-{{ forloop.index }} .caption-1 {
          font-size: {{ bst.fz_cap1_md }}px;
          margin-bottom: {{ bst.mb1_md }}px;
        }
        #shopify-section-{{ section.id }} .content-{{ forloop.index }} .caption-2 {
          font-size: {{ bst.fz_cap2_md }}px;
          margin-bottom: {{ bst.mb2_md }}px;
        }
        #shopify-section-{{ section.id }} .content-{{ forloop.index }} .caption-3 {
          font-size: {{ bst.fz_cap3_md }}px;
          margin-bottom: {{ bst.mb3_md }}px;
        }
        #shopify-section-{{ section.id }} .content-{{ forloop.index }} .caption-4 {
          font-size: {{ bst.fz_cap4_md }}px;
          margin-bottom: {{ bst.mb4_md }}px;
        }
      }
      @media(max-width: 767px) {

        #shopify-section-{{ section.id }} .content-{{ forloop.index }} {
          {% if settings.enable_rtl and iso_rtl %}{{ bst.position_sm | downcase | replace: 'left', 'right' }}{% else %}{{ bst.position_sm }}{% endif %};
        }
        #shopify-section-{{ section.id }} .content-{{ forloop.index }} .caption-1 {
          font-size: {{ bst.fz_cap1_sm }}px;
        }
        #shopify-section-{{ section.id }} .content-{{ forloop.index }} .caption-2 {
          font-size: {{ bst.fz_cap2_sm }}px;
        }
        #shopify-section-{{ section.id }} .content-{{ forloop.index }} .caption-3 {
          font-size: {{ bst.fz_cap3_sm }}px;
        }
        #shopify-section-{{ section.id }} .content-{{ forloop.index }} .caption-4 {
          font-size: {{ bst.fz_cap4_sm }}px;
        }
        #shopify-section-{{ section.id }} .slide-image-{{ forloop.index }} {
          background-image: url({{ bst.image | img_url: '767x' }});
        }
      }
      @media(max-width: 575px) {
        #shopify-section-{{ section.id }} .slide-image.s-{{ forloop.index }} {
          min-height: {{ sst.h_xs }}px;
        }
        #shopify-section-{{ section.id }} .slide-image.s-{{ forloop.index }} .respone_image {
          min-height: {{ sst.h_xs }}px;
        }

        #shopify-section-{{ section.id }} .content-{{ forloop.index }} {
          {% if settings.enable_rtl and iso_rtl %}{{ bst.position_xs | downcase | replace: 'left', 'right' }}{% else %}{{ bst.position_xs }}{% endif %};
        }
        #shopify-section-{{ section.id }} .content-{{ forloop.index }} .caption-1 {
          font-size: {{ bst.fz_cap1_xs }}px;
          margin-bottom: {{ bst.mb1_xs }}px;
        }
        #shopify-section-{{ section.id }} .content-{{ forloop.index }} .caption-2 {
          font-size: {{ bst.fz_cap2_xs }}px;
          margin-bottom: {{ bst.mb2_xs }}px;
        }
        #shopify-section-{{ section.id }} .content-{{ forloop.index }} .caption-3 {
          font-size: {{ bst.fz_cap3_xs }}px;
          margin-bottom: {{ bst.mb3_xs }}px;
        }
        #shopify-section-{{ section.id }} .content-{{ forloop.index }} .caption-4 {
          font-size: {{ bst.fz_cap4_xs }}px;
          margin-bottom: {{ bst.mb4_xs }}px;
        }
      }
    {% endfor %}
    @media(min-width: 768px) {
      #shopify-section-{{ section.id }} .distance {
        padding-top: {{ sst.distance_top_md }}px;
        padding-bottom: {{ sst.distance_bottom_md }}px;
      }
    }
    @media(min-width: 1200px) {
      #shopify-section-{{ section.id }} .distance {
        padding-top: {{ sst.distance_top_xl }}px;
        padding-bottom: {{ sst.distance_bottom_xl }}px;
      }
    }

    .section-slideshow {
    .main-slider-navfor {
      .slick-list {
        .slick-slide.slick-current {
          img {
            filter: none !important;
          }
        }
      }
    }

  }
{% endstyle %}

<div
  class="distance{% if sst.class != blank %} {{ sst.class }}{% endif %}{% if sst.animate %} wow fadeInUp animated{% endif %}"
  data-section-id="{{ section.id }}"
  data-section-type="slideshow-section"
>
  <div class="{{ sst.container }}">
    {% comment %} Slideshow {% endcomment %}
    <div class="slideshow position-relative">
      {% if section.blocks.size > 0 %}
        <div
          class="main-slider"
          data-autoplay="{{ sst.autoplay }}"
          data-speed="{{ sst.autoplay_speed }}"
          data-arrows="{{ sst.arrows }}"
          data-dots="false"
          {% if sst.loading_bar %}
            data-loading-bar
          {% endif %}
          data-zoom="{{ sst.zoom }}"
        >
          {% for block in section.blocks %}
            {% assign bst = block.settings %}
            {% if block.type == 'image' %}
              <div class="item">
                <div class="slide-image s-{{ forloop.index }}{% if forloop.first %} first-scale{% endif %}">
                  {% assign img_url = bst.image %}
                  <div
                    class="respone_image{% if bst.img_xs != blank %} d-none d-sm-block{% endif %}"
                    style="padding-top:{{ 1 | divided_by: img_url.aspect_ratio | times: 100}}%;"
                  >
                    {%- if block.settings.image != blank -%}
                      {%- assign imagealt = block.settings.image.alt | default: 'image-slide' | strip_html | escape -%}
                      {{
                        block.settings.image
                        | image_url: width: 3840
                        | image_tag:
                          loading: 'lazy',
                          class: 'image-entity lazyload',
                          alt: imagealt,
                          widths: '200, 320, 525, 768, 992, 1200, 1440, 1920, 2048, 3840'
                      }}
                    {% else %}
                      {% capture current %}{% cycle 1, 2, 3 %}{% endcapture %}
                      {{ 'hero-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                    {% endif %}
                  </div>
                  {% if bst.img_xs != blank %}
                    {% assign img_url = bst.img_xs %}
                    <div
                      class="respone_image d-sm-none"
                      style="padding-top:{{ 1 | divided_by: img_url.aspect_ratio | times: 100}}%;"
                    >
                      block.settings.image.alt | default: 'image-slide' | strip_html | escape -%}
                      {{
                        block.settings.image
                        | image_url: width: 1080
                        | image_tag:
                          loading: 'lazy',
                          class: 'image-entity lazyload',
                          alt: imagealt,
                          widths: '320, 525, 768, 1080'
                      }}
                    </div>
                  {% endif %}
                </div>
                {% if bst.cap_content == 'container' %}
                  <div class="cap_content container">
                {% endif %}
                {% unless bst.img == blank %}
                  <div class="caption-img-element-{{ forloop.index }}{% if bst.img_animate %} img_animate{% endif %} d-inline-block position-absolute">
                    <img data-src="{{ bst.img | img_url: '1440x' }}" class="lazyload layer w-100" data-depth="0.4">
                  </div>
                {% endunless %}
                <div class="content position-absolute content-{{ forloop.index }} text-{{ bst.text_align_xs }} text-sm-{{ bst.text_align }}">
                  {% unless bst.caption_1 == blank %}
                    <div
                      class="caption-animate caption-1 {{ bst.ff1 }} font-{{ bst.fw1 }} text-{{ bst.tt1 }} font-{{ bst.fs1 }}"
                      data-animate="{{ bst.cap_animate_1 }} animated"
                      style="color: {{ bst.color_cap1 }};"
                    >
                      {{ bst.caption_1 }}
                    </div>
                  {% endunless %}
                  {% unless bst.caption_2 == blank %}
                    <div
                      class="caption-animate caption-2 {{ bst.ff2 }} font-{{ bst.fw2 }} text-{{ bst.tt2 }} font-{{ bst.fs2 }}"
                      data-animate="{{ bst.cap_animate_2 }} animated"
                      style="color: {{ bst.color_cap2 }};"
                    >
                      {{ bst.caption_2 }}
                    </div>
                  {% endunless %}
                  {% unless bst.caption_3 == blank %}
                    <div
                      class="caption-animate caption-3 {{ bst.ff3 }} font-{{ bst.fw3 }} text-{{ bst.tt3 }} font-{{ bst.fs3 }}"
                      data-animate="{{ bst.cap_animate_3 }} animated"
                      style="color: {{ bst.color_cap3 }};"
                    >
                      {{ bst.caption_3 }}
                    </div>
                  {% endunless %}
                  {% unless bst.caption_4 == blank %}
                    <div
                      class="caption-animate caption-4 {{ bst.ff4 }} font-{{ bst.fw4 }} text-{{ bst.tt4 }} font-{{ bst.fs4 }}"
                      data-animate="{{ bst.cap_animate_4 }} animated"
                      style="color: {{ bst.color_cap4 }};"
                    >
                      {% if bst.caption_link != blank %}
                        <a href="{{ bst.caption_link }}" style="color: {{ bst.color_cap4 }};">
                      {% endif %}
                      {{ bst.caption_4 }}
                      {% if bst.caption_link != blank %}
                        </a>
                      {% endif %}
                    </div>
                  {% endunless %}
                  <div
                    class="caption-animate caption-btn d-flex color-{{ bst.color_button }} {{ align_item }} align-items-sm-center {{ justify_xs }} {{ justify }}"
                    data-animate="{{ bst.button_animate }} animated"
                  >
                    {% if bst.caption_btn != blank %}
                      <a class="btn {{ bst.btn_type }} {{ bst.btn_size }} text-uppercase" href="{{ bst.slider_link }}">
                        {{ bst.caption_btn | nofilter }}
                      </a>
                    {% endif %}
                  </div>
                </div>
                {% if bst.cap_content == 'container' %}
                  </div>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
        <div class="main-slider-navfor">
          {% for block in section.blocks %}
            {% assign bst = block.settings %}
            {% if block.type == 'image' %}
              <div class="item">
                <div class="slide-image">
                  {% assign img_url = bst.image %}
                  {%- if block.settings.image != blank -%}
                    {%- assign imagealt = block.settings.image.alt | default: 'image-slide' | strip_html | escape -%}
                    {{
                      block.settings.image
                      | image_url: width: 3840
                      | image_tag:
                        loading: 'lazy',
                        class: 'img-fluid',
                        alt: imagealt,
                        widths: '200, 320, 525, 768, 992, 1200, 1440, 1920, 2048, 3840'
                    }}
                  {% else %}
                    {% capture current %}{% cycle 1, 2, 3 %}{% endcapture %}
                    {{ 'hero-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                  {% endif %}
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
        {% if sst.dots %}
          <div class="slideshow-dot-cus position-absolute">
            {% for block in section.blocks %}
              {% if block.type == 'image' %}
                <div class="dot-color" data-slick-to data-index="{{ forloop.index0 }}">
                  <svg>
                    <circle cx='7' cy='7' r='6' fill="none" stroke-width="2"/>
                  </svg>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      {% endif %}
    </div>
    {% comment %} End Slideshow {% endcomment %}
  </div>
</div>

{% schema %}
{
  "name": "Vinova Slideshow",
  "class": "section-slideshow",
  "settings": [
    {
      "type": "header",
      "content": "Slideshow option"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "zoom",
      "label": "Zoom image",
      "default": true
    },
    {
      "type": "select",
      "id": "autoplay_speed",
      "label": "Change slides every",
      "options": [
        { "value": "4000", "label": "4 seconds" },
        { "value": "5000", "label": "5 seconds" },
        { "value": "6000", "label": "6 seconds" },
        { "value": "7000", "label": "7 seconds" },
        { "value": "8000", "label": "8 seconds" },
        { "value": "9000", "label": "9 seconds" },
        { "value": "10000", "label": "10 seconds" }
      ],
      "default": "4000"
    },
    {
      "type": "checkbox",
      "id": "enable_mh",
      "label": "Enable max height",
      "default": true
    },
    {
      "type": "number",
      "id": "mh",
      "label": "Max height (px)"
    },
    {
      "type": "paragraph",
      "content": "Usually used when you don't want the height of the slideshow to be too large on a 4k screen"
    },
    {
      "type": "number",
      "id": "h_xs",
      "label": "Min height slideshow mobile (px) 575px ↓",
      "default": 230,
      "info": "Use in case there is no mobile image"
    },
    {
      "type": "header",
      "content": "Loading bar"
    },
    {
      "type": "checkbox",
      "id": "loading_bar",
      "label": "Enable loading bar when auto rotate slides",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_load",
      "label": "Background loading bar",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "bg_load_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Opacity loading bar",
      "default": 15
    },
    {
      "type": "checkbox",
      "id": "arrows",
      "label": "Enable arrows",
      "default": false
    },
    {
      "type": "header",
      "content": "Dots"
    },
    {
      "type": "checkbox",
      "id": "dots",
      "label": "Enable dots",
      "default": false
    },
    {
      "type": "color",
      "id": "c_dot",
      "label": "Color dots",
      "default": "#f4f4f4"
    },
    {
      "type": "range",
      "id": "c_dot_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Color opacity",
      "default": 100
    },
    {
      "type": "color",
      "id": "c_dot_a",
      "label": "Color dots active",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "bd_dot_a",
      "label": "Border dots active",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "bd_dot_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Border dot opacity",
      "default": 30
    },
    {
      "type": "header",
      "content": "Progress bar"
    },
    {
      "type": "checkbox",
      "id": "progress_num",
      "label": "Enable progress bar",
      "default": true
    },
    {
      "type": "color",
      "id": "c_nbprogress_1",
      "label": "Color 1",
      "default": "#7c7c7c"
    },
    {
      "type": "color",
      "id": "c_nbprogress_2",
      "label": "Color 2",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "c_progress_1",
      "label": "Color 1",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "c_progress_2",
      "label": "Color 2",
      "default": "#ED1D24"
    },
    {
      "type": "header",
      "content": "Design option"
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Show animated",
      "default": true
    },
    {
      "type": "text",
      "id": "class",
      "label": "Class"
    },
    {
      "type": "header",
      "content": "Spacing top (px)"
    },
    {
      "type": "number",
      "id": "distance_top_xl",
      "label": "Large laptop",
      "default": 30,
      "info": "Breakpoint 1200px"
    },
    {
      "type": "number",
      "id": "distance_top_md",
      "label": "Tablet",
      "default": 30,
      "info": "Breakpoint 768px"
    },
    {
      "type": "number",
      "id": "distance_top_xs",
      "label": "Mobile",
      "default": 30
    },
    {
      "type": "header",
      "content": "Spacing bottom (px)"
    },
    {
      "type": "number",
      "id": "distance_bottom_xl",
      "label": "Large laptop",
      "default": 30,
      "info": "Breakpoint 1200px"
    },
    {
      "type": "number",
      "id": "distance_bottom_md",
      "label": "Tablet",
      "default": 30,
      "info": "Breakpoint 768px"
    },
    {
      "type": "number",
      "id": "distance_bottom_xs",
      "label": "Mobile",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image slideshow",
          "info": "1920 x 750px recommend"
