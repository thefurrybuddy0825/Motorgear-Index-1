{% assign sst = section.settings %}
{% style %}
  {%- assign bg_image = sst.background_image -%}
  #shopify-section-{{ section.id }} .distance {
    padding-top: {{ sst.distance_top_xs }}px;
    padding-bottom: {{ sst.distance_bottom_xs }}px;
    {% if sst.background_color != blank or bg_image != blank %}
      background: {{ sst.background_color }}{% if bg_image != blank %} url("{{ bg_image | img_url: '' }}"){% endif %} center;
      background-size: cover;
    {% endif %}
  }
  @media(min-width: 768px) {
    #shopify-section-{{ section.id }} .distance {
      padding-top: {{ sst.distance_top_md }}px;
      padding-bottom: {{ sst.distance_bottom_md }}px;
    }
  }
  @media(min-width: 1200px) {
    #shopify-section-{{ section.id }} .distance {
      padding-top: {{ sst.distance_top_xl }}px;
      padding-bottom: {{ sst.distance_bottom_xl }}px;
    }
  }
  {%- if sst.show_boxshadow %}
    #shopify-section-{{ section.id }} .container-inner {
      box-shadow: 5px 5px 15px rgba({{ sst.c_boxshadow | color_to_rgb | remove: 'rgb(' | remove: 'rgba(' | remove: ')' | remove: ', 0.0' }}, 10%);
    }
  {% endif -%}
  {% if sst.show_seemore %}
    {% if sst.background_color != 'rgba(0,0,0,0)' and sst.background_color != blank %}
      #shopify-section-{{ section.id }} [nov-item-act]:before {
        background: linear-gradient(to top,rgba({{ sst.background_color | color_to_rgb | remove: 'rgb(' | remove: 'rgba(' | remove: ')' | remove: ', 0.0' }}, 90%),rgba({{ sst.background_color | color_to_rgb | remove: 'rgb(' | remove: 'rgba(' | remove: ')' | remove: ', 0.0' }}, 10%));
      }
    {% endif %}
  {% endif %}
  {% for block in section.blocks %}
    {% assign bst = block.settings %}
    #shopify-section-{{ section.id }} .block-{{ forloop.index }}.nov-text {
      color: {{ bst.t_c }};
      font-size: {{ bst.t_s | divided_by: 10.0 }}rem;
      line-height: {{ bst.t_lh }};
      letter-spacing: {{ bst.t_lt }}px;
      text-transform: {{ bst.t_tt }};
      max-width: {{ bst.t_m }}px;
      margin-bottom: {{ bst.distance_bottom }}px;
    }
    #shopify-section-{{ section.id }} .block-{{ forloop.index }}.nov-text strong {
      color:  {{ bst.tb_c }};
    }
    #shopify-section-{{ section.id }} .block-{{ forloop.index }}.nov-text li::marker {
      color: rgba({{ bst.t_c | color_to_rgb | remove: 'rgb(' | remove: 'rgba(' | remove: ')' | remove: ', 0.0' }}, 65%);
    }
    {% if block.type == 'btn' %}
      #shopify-section-{{ section.id }} .block-{{ forloop.index }}.btn {
        color: {{ bst.c_btn }};
        background-color: {{ bst.b_btn }};
        border-color: {{ bst.bd_btn }};
        margin-bottom: {{ bst.distance_bottom }}px;
      }
      #shopify-section-{{ section.id }} .block-{{ forloop.index }}.btn:hover {
        color: {{ bst.c_btn_h }} !important;
        background-color: {{ bst.b_btn_h }} !important;
        border-color: {{ bst.bd_btn_h }} !important;
      }
    {% endif %}
    {% if block.type == 'policy' %}
      #shopify-section-{{ section.id }} .block-{{ forloop.index }}.policy {
        color: {{ bst.c_p }} !important;
        max-width: {{ bst.p_m }}px;
        font-size: {{ bst.p_s | divided_by: 10.0 }}rem;
        margin-bottom: {{ bst.distance_bottom }}px;
      }
      {% if bst.bg_p != 'rgba(0,0,0,0)' and bst.bg_p != blank %}
        #shopify-section-{{ section.id }} .block-{{ forloop.index }} .policy-content {
          background-color: {{ bst.bg_p }};
        }
      {% endif %}
      #shopify-section-{{ section.id }} .block-{{ forloop.index }} .policy-item {
        width: {{ 100 | divided_by:  bst.w }}%;
        flex: 0 0 {{ 100 | divided_by:  bst.w }}%;
      }
    {% endif %}
    {% if block.type == 'image' %}
      #shopify-section-{{ section.id }} .block-{{ forloop.index }}.nov-image {
        margin-bottom: {{ bst.distance_bottom }}px;
      }
      {%- if block.settings.max_w -%}
          #shopify-section-{{ section.id }} .block-{{ forloop.index }}.nov-image .image-content {
            max-width: {{ bst.w_xs }}px;
          }
        {%- endif %}
    {% endif %}
    {% if block.type == 'number' %}
      #shopify-section-{{ section.id }} .block-{{ forloop.index }}.nov-number .number {
        color: {{ bst.c_n }} !important;
        font-size: {{ bst.fzn | divided_by: 10.0 }}rem;
      }
      #shopify-section-{{ section.id }} .block-{{ forloop.index }}.nov-number .number-title {
        color: {{ bst.c_t }} !important;
        font-size: {{ bst.fzt | divided_by: 10.0 }}rem;
      }
    {% endif %}
  {% endfor %}
  @media(max-width: 991px) {
    {% for block in section.blocks %}
      {% assign bst = block.settings %}
      #shopify-section-{{ section.id }} .block-{{ forloop.index }}.nov-text {
        font-size: {{ bst.t_s_md | divided_by: 10.0 }}rem;
      }
    {% endfor %}
  }
  @media(min-width: 576px) {
    {% for block in section.blocks %}
      {% if block.type == 'image' %}
        {%- if block.settings.max_w -%}
          #shopify-section-{{ section.id }} .block-{{ forloop.index }}.nov-image .image-content {
            max-width: {{ block.settings.w_sm }}px;
          }
        {%- endif %}
      {% endif %}
    {% endfor %}
  }
  @media(min-width: 768px) {
    {% for block in section.blocks %}
      {% if block.type == 'image' %}
        {%- if block.settings.max_w -%}
          #shopify-section-{{ section.id }} .block-{{ forloop.index }}.nov-image .image-content {
            max-width: {{ block.settings.w_md }}px;
          }
        {%- endif %}
      {% endif %}
    {% endfor %}
  }
  @media(min-width: 992px) {
    {% for block in section.blocks %}
      {% if block.type == 'image' %}
        {%- if block.settings.max_w -%}
          #shopify-section-{{ section.id }} .block-{{ forloop.index }}.nov-image .image-content {
            max-width: {{ block.settings.w_lg }}px;
          }
        {%- endif %}
      {% endif %}
    {% endfor %}
  }
  @media(min-width: 1200px) {
    {% for block in section.blocks %}
      {% if block.type == 'image' %}
        {%- if block.settings.max_w -%}
          #shopify-section-{{ section.id }} .block-{{ forloop.index }}.nov-image .image-content {
            max-width: {{ block.settings.w }}px;
          }
        {%- endif %}
      {% endif %}
    {% endfor %} 
{% endstyle %}
<div class="distance{% if sst.class != blank %} {{ sst.class }}{% endif %}">
  <div class="{{ sst.container }}">
    <div class="position-relative overflow_hidden">
      <div class="nov-block__text {{ sst.title_alignment }}"{% if sst.show_seemore %} nov-item-act data-act="{{ section.id }}"{% endif %}>
        {% for block in section.blocks %}
          {% assign bst = block.settings %}
          {% if block.type == 'text' %}
            <div class="nov-text {{ bst.t_fw }} {{ bst.ff }} block-{{ forloop.index }}{% if sst.animate %} wow fadeInUp animated{% endif %}" data-wow-delay="{{ forloop.index | times: 0.1 }}s">{{ bst.text }}</div>
          {% endif %}
          {% if block.type == 'btn' %}
            <a href="{{ bst.btn_link }}" class="btn {{ bst.btn_type }} {{ bst.btn_size }} block-{{ forloop.index }}{% if sst.animate %} wow fadeInUp animated{% endif %}" data-wow-delay="{{ forloop.index | times: 0.1 }}s">{{ bst.btn }}</a>
          {% endif %}
          {% if block.type == 'image' %}
            <div class="nov-image block-{{ forloop.index }}{% if sst.animate %} wow fadeInUp animated{% endif %}" data-wow-delay="{{ forloop.index | times: 0.1 }}s">
              <div class="image-content">
                {% if bst.link != blank %}
                  <a href="{{ bst.btn_link }}">
                {% endif %}
                  {%- render 'nov-aspect-image', image: bst.image -%}
                {% if bst.link != blank %}</a>{% endif %}
              </div>
            </div>
          {% endif %}
          {% if block.type == 'policy' %}
            <div class="policy block-{{ forloop.index }} {{ bst.style }}{% if bst.bg_p != 'rgba(0,0,0,0)' and bst.bg_p != blank %} bg_item{% endif %}">
              {%- assign index = forloop.index -%}
              {% for i in (1..4) %}
                {%- assign pId = 'p' | append: i -%}
                {%- assign iconId = 'icon' | append: i -%}
                {%- capture time -%}{% cycle 0.1, 0.15, 0.2, 0.25 %}{%- endcapture -%}
                {% if bst[pId] != blank %}
                  <div class="policy-item{% if sst.animate %} wow fadeInUp animated{% endif %}" data-wow-delay="{{ index | times: time }}s">
                    <div class="policy-content">
                      {% if bst[iconId] != blank %}
                        <div class="p-icon text-center"><img data-src="{{ bst[iconId] | img_url: '100x' }}" class="lazyload d-inline-block"></div>
                      {% endif %}
                      <span>{{ bst[pId] }}</span>
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
          {% if block.type == 'number' %}
            <div class="nov-number block-{{ forloop.index }}{% if sst.animate %} wow fadeInUp animated{% endif %}" data-wow-delay="{{ forloop.index | times: 0.3 }}s">
              <div class="number-content d-flex align-items-center">
                {% for i in (1..4) %}
                  {%- assign nId = 'n' | append: i -%}
                  {%- assign ntId = 'nt' | append: i -%}
                  {% if bst[nId] != blank %}
                    <div class="number-item">
                      <div class="number"><span class="number-animate" data-scrollable>{{ bst[nId] }}</span>+</div>
                      {% if bst[ntId] != blank %}
                        <div class="number-title">{{ bst[ntId] }}</div>
                      {% endif %}
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
      {% if sst.show_seemore %}
        <div class="btn-show__content text-center font-600 text-uppercase mt-20" nov-btn-act data-toggle="{{ section.id }}">
          <span class="see_more pointer c_df hover:c_pr">{{ 'general.button.see_more' | t }}</span>
          <span class="see_less pointer c_df hover:c_pr">{{ 'general.button.see_less' | t }}</span>
        </div>
      {% endif %}
    </div>
  </div>
</div>
{% schema %}
