{%- assign sst = section.settings -%}
{%- assign bg_image = sst.background_image -%}
{% style %}
  .nov-footer {
    {% if sst.background_color != blank %}
      background-color: {{ sst.background_color }};
    {% endif %}
    {% if bg_image.src != blank %}
      background-image: url("{{ bg_image | img_url: '1920x' }}");
      background-size: cover;
      background-position: center;
    {% endif %}
  }
{% endstyle %}
<footer class="color-{{ sst.color_section }}{% if sst.animate == true %} wow fadeInUp animated{% endif %}">
  {% if section.blocks.size > 0 %}
    <div class="footer-layout pt-40 pb-30">
      <div class="{{ sst.container }}">
        <div class="row">
          {% for block in section.blocks %}
            {% assign bst = block.settings %}
            {% if block.type == 'block_contact' %}
              <div class="footer_contact block_footer block-{{ forloop.index }}{% if bst.block_title != blank and sst.mobile_acc %} mt-xs-0 mb-xs-0{% endif %} {{ bst.grid_xxl }} {{ bst.grid_xl }} {{ bst.grid_lg }} {{ bst.grid_md }} {{ bst.grid_sm }}{% if bst.block_class != blank %} {{ bst.block_class }}{% endif %}">
                <div class="block h-100">
                  {% if bst.block_title != blank or bst.block_subtitle != blank %}
                    <div class="title-block{% if bst.h_t %} d-sm-none{% endif %}">
                      <h2 class="footer_headding">
                        {{ bst.block_title }}
                      </h2>
                      {% if bst.block_subtitle != blank %}
                        <div class="footer-subtitle mb-0">{{ bst.block_subtitle }}</div>
                      {% endif %}
                      {% if sst.mobile_acc and bst.phone != blank or bst.email != blank or bst.open != blank %}
                        <span class="f_btn_sl d-sm-none">
                          <i class="zmdi zmdi-plus"></i>
                        </span>
                      {% endif %}
                    </div>
                  {% endif %}
                  <div class="block-content{% if bst.block_title != blank and sst.mobile_acc %} h_t{% endif %}">
                    <div class="pb-xs-0">
                      {% if bst.image != blank %}
                        <div class="logo-footer mb-24" style="max-width: {{ bst.max_width_logo | append: 'px'}};">
                          {%- assign imagealt = bst.image.alt | default: 'icon-text' | strip_html | escape -%}
                          {{ bst.image | image_url: width: 500 | image_tag: loading: 'lazy', class: 'img-fluid', alt: imagealt, widths: '206 250 300 500'
                          }}
                        </div>
                      {% endif %}
                      {% if bst.address != blank %}
                        <div class="footertop-item__contact d-flex align-items-end">
                          <div class="footertop-item__icon">{% render 'icon-pin' %}</div>
                          <span>{{ bst.address }}</span>
                        </div>
                      {% endif %}
                      {% if bst.phone != blank %}
                        <div class="footertop-item__contact d-flex align-items-end">
                          <div class="footertop-item__icon">{% render 'icon-phone' %}</div>
                          <a href="tel: {{ bst.phone }}">{{ bst.phone }}</a>
                        </div>
                      {% endif %}
                      {% if bst.email != blank %}
                        <div class="footertop-item__contact d-flex align-items-end">
                          <div class="footertop-item__icon">{% render 'icon-email' %}</div>
                          <a href="mailto:{{ bst.email }}">{{ bst.email }}</a>
                        </div>
                      {% endif %}
                      {% if bst.business_time != blank %}
                        <div class="footertop-item__contact d-flex align-items-end">
                          <div class="footertop-item__icon">{% render 'icon-clock' %}</div>
                          <span>{{ bst.business_time }}</span>
                        </div>
                      {% endif %}
                    </div>
                  </div>
                </div>
              </div>
            {% endif %}

            {% if block.type == 'block_menu' %}
              {%- assign footer_linklist = bst.menu_handle -%}
              <div class="footer_menu block_footer block-{{ forloop.index }}{% if bst.block_title != blank and sst.mobile_acc %} mt-xs-0 mb-xs-0{% endif %} {{ bst.grid_xxl }} {{ bst.grid_xl }} {{ bst.grid_lg }} {{ bst.grid_md }} {{ bst.grid_sm }}{% if bst.block_class != blank %} {{ bst.block_class }}{% endif %}">
                <div class="block h-100">
                  {% if bst.block_title != blank %}
                    <div class="title-block{% if bst.h_t %} d-sm-none{% endif %}">
                      <h2 class="footer_headding">
                        {{ bst.block_title }}
                      </h2>
                      {% if sst.mobile_acc %}
                        <span class="f_btn_sl d-sm-none">
                          <i class="zmdi zmdi-plus"></i>
                        </span>
                      {% endif %}
                    </div>
                  {% endif %}
                  <div class="block-content{% if bst.block_title != blank and sst.mobile_acc %} h_t{% endif %}">
                    {% if linklists[footer_linklist].links.size > 0 %}
                      <ul class="site-footer__linklist list-unstyled pb-xs-30">
                        {% for link in linklists[footer_linklist].links %}
                          <li class="site-footer__linklist-item">
                            <a href="{{ link.url }}">{{ link.title }}</a>
                          </li>
                        {% endfor %}
                      </ul>
                    {% endif %}
                  </div>
                </div>
              </div>
            {% endif %}

            {% if block.type == 'block_html' %}
              <div class="footer_html block_footer block-{{ forloop.index }}{% if bst.block_title != blank and sst.mobile_acc %} mt-xs-0 mb-xs-0{% endif %} {{ bst.grid_xxl }} {{ bst.grid_xl }} {{ bst.grid_lg }} {{ bst.grid_md }} {{ bst.grid_sm }}{% if bst.block_class != blank %} {{ bst.block_class }}{% endif %}">
                <div class="block h-100">
                  {% if bst.block_title != blank %}
                    <div class="title-block{% if bst.h_t %} d-sm-none{% endif %}">
                      <h2 class="footer_headding">
                        {{ bst.block_title }}
                      </h2>
                      {% if sst.mobile_acc %}
                        <span class="f_btn_sl d-sm-none">
                          <i class="zmdi zmdi-plus"></i>
                        </span>
                      {% endif %}
                    </div>
                  {% endif %}
                  <div class="block-content{% if bst.block_title != blank and sst.mobile_acc %} h_t{% endif %}">
                    <div class="pb-xs-30">
                      {% if bst.img != blank %}<img data-src="{{ bst.img | img_url: '190x' }}" class="lazyload mb-md-10">{% endif %}
                      {% if bst.html_content != blank %}
                        <div class="bl_html">{{ bst.html_content }}</div>
                      {% endif %}
                      {% if bst.show_social %}
                        <div class="mt-25">{% render 'nov-social' %}</div>
                      {% endif %}
                    </div>
                  </div>
                </div>
              </div>
            {% endif %}

            {% if block.type == 'block_newsletter' %}
              <div class="footer_newsletter block_footer block-{{ forloop.index }}{% if bst.block_title != blank and sst.mobile_acc %} mt-xs-0 mb-xs-0{% endif %} {{ bst.grid_xxl }} {{ bst.grid_xl }} {{ bst.grid_lg }} {{ bst.grid_md }} {{ bst.grid_sm }}{% if bst.block_class != blank %} {{ bst.block_class }}{% endif %}">
                <div class="block h-100">
                  {% if bst.block_title != blank %}
                    <div class="title-block{% if bst.h_t %} d-sm-none{% endif %}">
                      <h2 class="footer_headding">
                        {{ bst.block_title }}
                      </h2>
                      {% if sst.mobile_acc %}
                        <span class="f_btn_sl d-sm-none">
                          <i class="zmdi zmdi-plus"></i>
                        </span>
                      {% endif %}
                    </div>
                  {% endif %}
                  <div class="block-content{% if bst.block_title != blank and sst.mobile_acc %} h_t{% endif %}">
                    <div class="pb-xs-30">
                      {% form 'customer'
                        , id: 'footer_contact' %}
                        {{ form.errors | default_errors }}
                        {% if form.posted_successfully? %}
                          <p class="form--success text-center font-bold">{{ 'general.newsletter_form.confirmation' | t }}</p>
                        {% else %}
                          <div class="input-group">
                            <input
                              type="hidden"
                              name="contact[tags]"
                              value="newsletter">
                            <input
                              type="email"
                              name="contact[email]"
                              id="Email_Footer"
                              class="input form-control"
                              value="{% if customer %}{{ customer.email }}{% endif %}"
                              placeholder="{{ 'general.newsletter_form.email_newsletter' | t }}"
                              required>
                            <button
                              type="submit"
                              class="btn btn-primary"
                              name="commit">
                              {{ 'general.newsletter_form.submit' | t }}
                            </button>
                          </div>
                        {% endif %}
                      {% endform %}
                      {% if bst.show_social %}
                        <div class="mt-25">{% render 'nov-social' %}</div>
                      {% endif %}
                    </div>
                  </div>
                </div>
              </div>
            {% endif %}

            {% if block.type == 'block_social' %}
              <div class="footer_social block_footer block-{{ forloop.index }}{% if bst.block_title != blank and sst.mobile_acc %} mt-xs-0 mb-xs-0{% endif %} {{ bst.grid_xxl }} {{ bst.grid_xl }} {{ bst.grid_lg }} {{ bst.grid_md }} {{ bst.grid_sm }}{% if bst.block_class != blank %} {{ bst.block_class }}{% endif %}">
                <div class="block h-100">
                  {% if bst.block_title != blank %}
                    <div class="title-block{% if bst.h_t %} d-sm-none{% endif %}">
                      <h2 class="footer_headding">
                        {{ bst.block_title }}
                      </h2>
                      {% if sst.mobile_acc %}
                        <span class="f_btn_sl d-sm-none">
                          <i class="zmdi zmdi-plus"></i>
                        </span>
                      {% endif %}
                    </div>
                  {% endif %}
                  <div class="block-content{% if bst.block_title != blank and sst.mobile_acc %} h_t{% endif %}">
                    <div class="pb-xs-0">
                      {% if bst.show_payment and shop.enabled_payment_types %}
                        {% if bst.payment_title %}
                          <div class="title-block mb-15">
                            <h2 class="footer_headding">
                              {{ bst.payment_title }}
                            </h2>
                          </div>
                        {% endif %}
                        <div class="footer__payment d-flex flex-wrap mb-25">
                          {% if bst.payment != blank %}
                            <img src="{{ bst.payment | img_url: '250x' }}">
                          {% else %}
                            {%- for type in shop.enabled_payment_types -%}
                              <div class="payment__item mt-sm-15">{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</div>
                            {%- endfor -%}
                          {% endif %}
                        </div>
                      {% endif %}
                      {% if bst.social_title %}
                        <div class="title-block mb-15">
                          <h2 class="footer_headding">
                            {{ bst.social_title }}
                          </h2>
                        </div>
                      {% endif %}
                      {% render 'nov-social-svg' color: bst.social_color_footer %}
                    </div>
                  </div>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}
  <div class="footer_copyright">
    <div class="{{ sst.container }}">
      <div class="copyright-content pt-26 pb-22">
        <div class="row align-items-center justify-content-betweent">
          <div class="col-lg-6 col-sm-8 col-12 text-sm-left text-center mb-0 mb-xs-15">
            <div class="copyright f_df">{{ sst.copyright }}</div>
          </div>
          <div class="col-lg-6 col-sm-4 col-12 justify-content-sm-end justify-content-center d-flex align-items-center footer-cu-lang">
            {%- if settings.show_language and localization.available_languages.size > 1 -%}
              <div class="footer-language">
                {% if bst.l_t != blank %}
                  <div class="text-dropdown font-700 text-uppercase">{{ bst.l_t }}</div>
                {% endif %}
                {% include 'nov-block-language', id: 'footer-language' color: '#8a8a8a' %}
              </div>
            {%- endif -%}
            {% if settings.show_multiple_currencies == true %}
              <div class="footer-currency">
                {% if bst.c_t != blank %}
                  <div class="text-dropdown font-700 text-uppercase">{{ bst.c_t }}</div>
                {% endif %}
                {% include 'nov-block-currency', type: 'dropdown' color: '#8a8a8a' %}
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>
{% schema %}
