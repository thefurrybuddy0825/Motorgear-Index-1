{% assign sst = section.settings %}
{% style %}
  {%- assign bg_image = sst.background_image -%}
  #shopify-section-{{ section.id }} .distance {
    padding-top: {{ sst.distance_top_xs }}px;
    padding-bottom: {{ sst.distance_bottom_xs }}px;
    {% if sst.background_color != blank or bg_image != blank %}
      background: {{ sst.background_color }}{% if bg_image != blank %} url("{{ bg_image | img_url: '' }}"){% endif %} no-repeat center;
      background-size: cover;
    {% endif %}
  }
  @media(min-width: 768px) {
    #shopify-section-{{ section.id }} .distance {
      padding-top: {{ sst.distance_top_md }}px;
      padding-bottom: {{ sst.distance_bottom_md }}px;
    }
  }
  @media(min-width: 1200px) {
    #shopify-section-{{ section.id }} .distance {
      padding-top: {{ sst.distance_top_xl }}px;
      padding-bottom: {{ sst.distance_bottom_xl }}px;
    }
  }
{% endstyle %}
<div class="distance{% if sst.class != blank %} {{ sst.class }}{% endif %}{% if sst.animate %} wow fadeInUp animated{% endif %}" data-section-id="{{ section.id }}">
  <div class="{{ sst.container }}">
    {% render 'heading-section' %}
    {% if section.blocks.size > 0 %}
      <div class="row spacing-{{ sst.spacing }}">
        {% for block in section.blocks %}
          <div class="sp-item {%- render 'number-to-col' -%}">
            <div class="manufacture__item overflow_hidden text-center">
              {% if block.settings.link != blank %}
                <a href="{{ block.settings.link }}" class="manufacture__link d-inline-block">
              {% endif %}
              {% if block.settings.image != blank %}
                <img data-src="{{ block.settings.image | img_url: '200x'}}" class="d-inline-block lazyload img-fluid" alt="{{ block.settings.image.alt }}">
              {% else %}
                {{ 'hero-apparel-3' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
              {% if block.settings.link != blank %}
                </a>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
    {% if section.blocks.size == 0 %}
      {% render 'no-blocks' %}
    {% endif %}
  </div>
</div>
{% schema %}
  {
    "name": "Vinova Manufacture",
    "class": "section-manufacture",
    "settings": [
      {
        "type": "richtext",
        "id": "heading",
        "label": "Heading",
        "default": "<p>Vinova Manufacture</p>"
      },
      {
        "type": "color",
        "id": "heading_color",
        "label": "Heading color",
        "default": "#222222"
