        "max": 10,
        "step": 1,
        "label": "Laptop",
        "default": 6,
        "info": "Breakpoint 992px"
      },
      {
        "type": "range",
        "id": "md",
        "min": 1,
        "max": 8,
        "step": 1,
        "label": "Tablet",
        "default": 6,
        "info": "Breakpoint 768px"
      },
      {
        "type": "range",
        "id": "sm",
        "min": 1,
        "max": 8,
        "step": 1,
