    ],
    "blocks": [
      {
        "type": "logo_image",
        "name": "Logo",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image",
            "info": "200 x 100px recommended"
          },
          {
            "type": "url",
            "id": "link",
            "label": "Link",
