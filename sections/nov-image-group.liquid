{%- assign sst = section.settings -%}
{%- assign bg_image = sst.background_image -%}
{%- style -%}
  #shopify-section-{{ section.id }} .distance {
    padding-top: {{ sst.distance_top_xs }}px;
    padding-bottom: {{ sst.distance_bottom_xs }}px;
    padding-left: {{ sst.px }}px;
    padding-right: {{ sst.px }}px;
    {% if sst.background_color != blank or bg_image.src != blank %}
      background: {{ sst.background_color }}{% if bg_image != blank %} url("{{ bg_image | img_url: '' }}") no-repeat center{% endif %};
      background-size: cover;
    {% endif %}
  }
  @media(min-width: 768px) {
    #shopify-section-{{ section.id }} .distance {
      padding-top: {{ sst.distance_top_md }}px;
      padding-bottom: {{ sst.distance_bottom_md }}px;
    }
  }
  @media(min-width: 1200px) {
    #shopify-section-{{ section.id }} .distance {
      padding-top: {{ sst.distance_top_xl }}px;
      padding-bottom: {{ sst.distance_bottom_xl }}px;
    }
  }
  #shopify-section-{{ section.id }} .gallery-image__item {
    border-radius: {{ sst.bd_radius }}px;
  }
  #shopify-section-{{ section.id }} .gallery-image__item .title {
    font-size: {{ sst.fz_t | divided_by: 10.0 }}rem;
  }
  #shopify-section-{{ section.id }} .gallery-image__item .desc {
    font-size: {{ sst.fz_d | divided_by: 10.0 }}rem;
  }
{%- endstyle -%}
<div class="distance color-{{ sst.color_section }}{% if sst.class != blank %} {{ sst.class }}{% endif %}{% if sst.animate %} wow fadeInUp animated{% endif %}">
  <div class="{{ sst.container }}">
    {% render 'heading-section' %}
    <div class="row spacing-{{ sst.spacing }}">
      {% for block in section.blocks %}
        {%- assign bst = block.settings -%}
        <div class="{{ bst.wg_lg }} {{ bst.wg_md }} {{ bst.wg_sm }} block-{{ forloop.index }}{% if bst.class_group != blank %} {{ bst.class_group }}{% endif %}">
          <div class="row spacing-{{ sst.spacing }} spacing-sm-10">
            {% for i in (1..4) %}
              {%- liquid
                assign wiId = 'wi' | append: i
                assign wi_md_Id = 'wi_md_' | append: i
                assign wi_sm_Id = 'wi_sm_' | append: i
                assign wi_xs_Id = 'wi_xs_' | append: i
                assign class_Id = 'class_' | append: i
                assign image_Id = 'image_' | append: i
                assign link_Id = 'link_' | append: i
                assign title_Id = 'title_' | append: i
                assign desc_Id = 'desc_' | append: i
                assign btn_Id = 'btn_' | append: i
              -%}
              <div class="{{ bst[wiId] }} {{ bst[wi_md_Id] }} {{ bst[wi_sm_Id] }} {{ bst[wi_xs_Id] }}{% if bst[class_Id] != blank %} {{ bst[class_Id] }}{% endif %}">
              {% if bst[image_Id] != blank %}
                <div class="gallery-image__item image-1{% if sst.style_img_1 %} nov-sh-image-1{% endif %}{% if sst.style_img_2 %} nov-sh-image-2{% endif %}">
                  {% if bst[link_Id] != blank %}
                    <a class="w-100" href="{{ bst[link_Id] }}">
                  {% endif %}
                  {% render 'nov-aspect-image', image: bst[image_Id] %}
                  {% if bst[link_Id] != blank %}
                    </a>
                  {% endif %}
                  {% if bst[title_Id] != blank or bst[desc_Id] != blank or bst[btn_Id] != blank %}
                    <div class="gallery-caption w-100 position-absolute bottom-center text-center font-700">
                      {% if bst[title_Id] != blank %}
                        <{% if bst[link_Id] != blank %}a href="{{ bst[link_Id] }}"{% else %}div{% endif %} class="title">{{ bst[title_Id] }}{% if bst[link_Id] != blank %}</a>{% else %}</div>{% endif %}
                      {% endif %}
                      {% if bst[desc_Id] != blank %}
                        <div class="desc mt-5">{{ bst[desc_Id] }}</div>
                      {% endif %}
                      {% if bst[btn_Id] != blank %}
                        <a href="{{ bst[link_Id] }}" class="btn{% if bst[link_Id] != blank or bst[desc_Id] != blank %} mt-10{% endif %}">{{ bst[btn_Id] }}</a>
                      {% endif %}
                    </div>
                  {% endif %}
                </div>
              {% endif %}
              </div>
            {% endfor %}
            {% if bst.image_1 == blank  %}
              <div class="{{ bst.wi1 }} {{ bst.wi_md_1 }} {{ bst.wi_sm_1 }} {{ bst.wi_xs_1 }}">
                {%- capture current -%}{% cycle 1, 2, 3 %}{%- endcapture -%}
                {{ 'blog-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>
