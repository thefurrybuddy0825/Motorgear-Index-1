{%- assign sst = section.settings -%}
{% style %}
  {%- assign bg_image = sst.background_image -%}
  #shopify-section-{{ section.id }} .distance {
    padding-top: {{ sst.distance_top_xs }}px;
    padding-bottom: {{ sst.distance_bottom_xs }}px;
    {% if sst.background_color != blank or bg_image != blank %}
      background: {{ sst.background_color }}{% if bg_image != blank %} url("{{ bg_image | img_url: '1920x' }}"){% endif %} no-repeat center;
      background-size: cover;
    {% endif %}
  }
  {%- if sst.gradient != blank -%}
    @media(min-width: 992px) {
      #shopify-section-{{ section.id }} .distance {
        background: {{ sst.gradient }};
      }
    }
  {%- endif -%}
  #shopify-section-{{ section.id }} .block-image .respone_image {
    border-radius: {{ sst.img_radius }}px;
    transform: translateZ(0);
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .block-image .respone_image img {
    object-fit: {{ sst.image_object_fit }};
  }
  #shopify-section-{{ section.id }} .block-text {
    padding-left: {{ sst.spacing_horizontal }}px;
    padding-right: {{ sst.spacing_horizontal }}px;
  }
  {% for block in section.blocks %}
    {% assign bst = block.settings %}
    #shopify-section-{{ section.id }} .block-{{ forloop.index }} {
      margin-bottom: {{ bst.distance_bottom_xs }}px;
    }
    #shopify-section-{{ section.id }} .block-{{ forloop.index }}.nov-text,
    #shopify-section-{{ section.id }} .block-{{ forloop.index }}.nov-text a {
      color: {{ bst.t_c }};
      font-size: {{ bst.t_s | divided_by: 10.0 }}rem;
      line-height: {{ bst.t_lh }};
      letter-spacing: {{ bst.t_lt }}px;
      text-transform: {{ bst.t_tt }};
      max-width: {{ bst.t_m }}px;
    }
    #shopify-section-{{ section.id }} .block-{{ forloop.index }}.nov-text a:hover {
        color:  {{ bst.c_link_h }};
      }
    {% if block.type == 'text' %}
      {% if bst.icon != blank %}
        #shopify-section-{{ section.id }} .block-{{ forloop.index }}.nov-text li:before {
          content:  url("{{ bst.icon | img_url: '15x' }}");
        }
      {% endif %}
      #shopify-section-{{ section.id }} .block-{{ forloop.index }}.nov-text strong {
        color:  {{ bst.tb_c }};
      }
    {% endif %}
    {% if block.type == 'btn' %}
      #shopify-section-{{ section.id }} .block-{{ forloop.index }} .btn {
        color: {{ bst.c_btn }};
        background-color: {{ bst.b_btn }};
      }
      #shopify-section-{{ section.id }} .block-{{ forloop.index }} .btn:hover {
        color: {{ bst.c_btn_h }} !important;
        background-color: {{ bst.b_btn_h }} !important;
      }
      #shopify-section-{{ section.id }} .block-{{ forloop.index }} .icon_play {
        color:  {{ bst.c_btn_video }};
      }
      #shopify-section-{{ section.id }} .block-{{ forloop.index }} .icon_play:hover {
        color:  {{ bst.c_btn_video_h }};
      }
    {% endif %}
    {% if block.type == 'policy' %}
      #shopify-section-{{ section.id }} .block-{{ forloop.index }}.policy {
        max-width: {{ bst.p_m }}px;
      }
      #shopify-section-{{ section.id }} .block-{{ forloop.index }}.policy .title {
        color: {{ bst.c_t }} !important;
        font-size: {{ bst.t_s | divided_by: 10.0 }}rem;
      }
      #shopify-section-{{ section.id }} .block-{{ forloop.index }}.policy .desc {
        color: {{ bst.c_d }} !important;
        font-size: {{ bst.d_s | divided_by: 10.0 }}rem;
      }
      {% if bst.bg_icon != 'rgba(0,0,0,0)' and bst.bg_icon != blank %}
        #shopify-section-{{ section.id }} .block-{{ forloop.index }}.policy .p-icon {
          background-color: {{ bst.bg_icon }};
        }
      {% endif %}
      {% if bst.bg != 'rgba(0,0,0,0)' and bst.bg != blank %}
        #shopify-section-{{ section.id }} .block-{{ forloop.index }} .policy-item-content {
          background-color: {{ bst.bg }};
          border-radius: 10px;
          overflow: hidden;
          transform: translateZ(0);
        }
      {% endif %}
    {% endif %}
    {% if block.type == 'image' %}
      #shopify-section-{{ section.id }} .block-{{ forloop.index }} {
        max-width: {{ bst.c_m }}px;
      }
      {% if bst.show_border %}
        #shopify-section-{{ section.id }} .block-{{ forloop.index }} .item-image {
          border: 1px solid {{ bst.c_border }};
          transition: 0.3s;
        }
        #shopify-section-{{ section.id }} .block-{{ forloop.index }} .item-image:hover {
          box-shadow: 0 8px 8px rgba(0,0,0,.05);
        }
      {% endif %}
    {% endif %}
    #shopify-section-{{ section.id }} .block-{{ forloop.index }}.contact {
      color: {{ bst.c_c }} !important;
      max-width: {{ bst.c_m }}px;
      font-size: {{ bst.c_s | divided_by: 10.0 }}rem;
    }
    #shopify-section-{{ section.id }} .block-{{ forloop.index }}.contact .item-icon {
      color: {{ bst.c_ic }} !important;
    }
  {% endfor %}
  @media(max-width: 1199px) {
    {% for block in section.blocks %}
      #shopify-section-{{ section.id }} .block-{{ forloop.index }}.nov-text {
        font-size: {{ block.settings.t_s_lg | divided_by: 10.0 }}rem;
      }
    {% endfor %}
  }
  @media(max-width: 991px) {
    {% for block in section.blocks %}
      #shopify-section-{{ section.id }} .block-{{ forloop.index }}.nov-text {
        font-size: {{ block.settings.t_s_md | divided_by: 10.0 }}rem;
      }
    {% endfor %}
  }
  @media(min-width: 768px) {
    #shopify-section-{{ section.id }} .distance {
      padding-top: {{ sst.distance_top_md }}px;
      padding-bottom: {{ sst.distance_bottom_md }}px;
    }
    {% for block in section.blocks %}
      #shopify-section-{{ section.id }} .block-{{ forloop.index }} {
        margin-bottom: {{ block.settings.distance_bottom_md }}px;
      }
    {% endfor %}
  }
  @media(min-width: 992px) {
    {% for block in section.blocks %}
      #shopify-section-{{ section.id }} .block-{{ forloop.index }} {
        margin-bottom: {{ block.settings.distance_bottom_lg }}px;
      }
    {% endfor %}
  }
  @media(min-width: 1200px) {
    #shopify-section-{{ section.id }} .distance {
      padding-top: {{ sst.distance_top_xl }}px;
      padding-bottom: {{ sst.distance_bottom_xl }}px;
    }
    {% for block in section.blocks %}
      #shopify-section-{{ section.id }} .block-{{ forloop.index }} {
        margin-bottom: {{ block.settings.distance_bottom_xl }}px;
      }
    {% endfor %}
  }
{% endstyle %}

<div class="distance{% if sst.class != blank %} {{ sst.class }}{% endif %}{% if sst.animate %} wow fadeInUp animated{% endif %}">
  <div class="{{ sst.container }}">
    {% render 'heading-section' %}
    <div class="row justify-content-lg-center content-{{ sst.image_size }} spacing-{{ sst.spacing }}{% if sst.position == 'under' %} flex-column-reverse{% endif %}{% if sst.position_lg == 'right' %} flex-lg-row-reverse{% endif %}">
      <div class="{{ sst.width_img }}">
        <div class="block-image h-100 position-relative{% if sst.image_animate %} nov-sh-image-2{% endif %}">
          {% if sst.image != blank %}
            {%- render 'nov-aspect-image', image: sst.image -%}
          {% else %}
            {{ 'collection-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
        </div>
      </div>
      <div class="{{ sst.width_text }} d-flex align-items-{{ sst.text_position_vertical }} justify-content-lg-{{ sst.text_position_horizontal }} mt-md-50">
        <div class="block-text {{ sst.alignment }}">
          {% for block in section.blocks %}
            {% assign bst = block.settings %}
            {% if block.type == 'text' %}
              <div class="nov-text {{ bst.t_fw }} block-{{ forloop.index }}{% if bst.ff == 'f_pr' %} f_pr{% endif %}{% if bst.icon != blank %} list-icon{% endif %}{% if sst.animate == true %} wow fadeInUp animated{% endif %}" data-wow-delay="{{ forloop.index | times: 0.1 }}s">{{ bst.text }}</div>
            {% endif %}
            {% if block.type == 'btn' %}
              <div class="block-btn block-{{ forloop.index }}{% if sst.animate == true %} wow fadeInUp animated{% endif %}" data-wow-delay="{{ forloop.index | times: 0.1 }}s">
                {% if bst.btn != blank %}
                  <a href="{{ bst.btn_link }}" class="btn btn-{{ bst.btn_size }}">{{ bst.btn }}</a>
                {% endif %}
                {% if bst.btn2 != blank %}
                  <a href="{{ bst.btn_link2 }}" class="btn btn-{{ bst.btn_size }}">{{ bst.btn2 }}</a>
                {% endif %}
                {% if bst.video_url != blank %}
                  <div class="icon_play d-inline-flex align-items-center pointer" data-toggle="modal" data-target="#ModalVideo" data-src="{% if bst.video_url.type == "youtube"  %}https://www.youtube.com/embed/{{ bst.video_url.id }}?rel=0&showinfo=0&vq=720{% endif %}{% if bst.video_url.type == "vimeo" %}//player.vimeo.com/video/{{ bst.video_url.id }}?byline=0&portrait=0&badge=0{% endif %}">
                    {{ 'sections.slideshow.watch_video' | t }}<i class="zmdi zmdi-play-circle-outline"></i>
                  </div>
                {% endif %}
              </div>
            {% endif %}
            {% if block.type == 'policy' %}
              <div class="policy block-{{ forloop.index }} {{ bst.style }}{% if bst.p4 != blank %} h-p4{% endif %}{% if bst.bg_icon != 'rgba(0,0,0,0)' and bst.bg_icon != blank %} bg_icon{% endif %} mb-sm-20">
                {%- for i in (1..6) -%}
                  {%- assign tId = 't' | append: i -%}
                  {%- assign dId = 'd' | append: i -%}
                  {%- assign iconId = 'icon' | append: i -%}
                  {% if bst[dId] != blank or bst[iconId] != blank %}
                    <div class="policy-item{% if sst.animate == true %} wow fadeInUp animated{% endif %}" data-wow-delay="{{ forloop.index | times: 0.1 }}s">
                      <div class="policy-item-content">
                        {% if bst[iconId] != blank %}
                          <div class="p-icon text-center icon1">
                            <img data-src="{{ bst[iconId] | img_url: '75x' }}" class="lazyload d-inline-block">
                          </div>
                        {% endif %}
                        <div class="block-right">
                          {% if bst[tId] != blank %}
                            <div class="title">{{ bst[tId] }}</div>
                          {% endif %}
                          {% if bst[dId] != blank %}
                            <div class="desc">{{ bst[dId] }}</div>
                          {% endif %}
                        </div>
                      </div>
                    </div>
                  {% endif %}
                {%- endfor -%}
              </div>
            {% endif %}
            {% if block.type == 'contact' %}
              <div class="contact block-{{ forloop.index }}{% if sst.animate == true %} wow fadeInUp animated{% endif %}" data-wow-delay="{{ forloop.index | times: 0.1 }}s">
                {% if bst.hotline != blank %}
                  <div class="item-contact d-flex align-items-center">
                    <div class="item-icon"><i class="rbb-icon-phone-2"></i></div>
                    <span class="font-700">{{ bst.hotline }}</span>
                  </div>
                {% endif %}
                {% if bst.email != blank %}
                  <div class="item-contact d-flex align-items-center">
                    <div class="item-icon"><i class="rbb-icon-email-6"></i></div>
                    <span>{{ bst.email }}</span>
                  </div>
                {% endif %}
                {% if bst.time != blank %}
                  <div class="item-contact d-flex align-items-center">
                    <div class="item-icon"><i class="rbb-icon-time-1"></i></div>
                    <span>{{ bst.time }}</span>
                  </div>
                {% endif %}
              </div>
            {% endif %}
            {% if block.type == 'image' %}
              <div class="images d-flex block-{{ forloop.index }}{% if sst.animate == true %} wow fadeInUp animated{% endif %}" data-wow-delay="{{ forloop.index | times: 0.1 }}s">
                {% if bst.img1 != blank %}
                  <div class="item-image" style="{% if bst.img2 != blank %}width: 50%{% else %}width: 100%{% endif %}">
                    {% if bst.img1l != blank %}
                      <a href="{{ bst.img1l }}">
                    {% endif %}
                    {% render 'nov-aspect-image', image: bst.img1 %}
                    {% if bst.img1l != blank %}
                      </a>
                    {% endif %}
                  </div>
                {% endif %}
                {% if bst.img2 != blank %}
                  <div class="item-image" style="width: 50%">
                    {% if bst.img2l != blank %}
                      <a href="{{ bst.img2l }}">
                    {% endif %}
                    {% render 'nov-aspect-image', image: bst.img2 %}
                    {% if bst.img2l != blank %}
                      </a>
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>
