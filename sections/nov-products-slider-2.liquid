{%- assign sst = section.settings -%}
{%- assign collection = collections[sst.collection] -%}
{%- assign product_limit = sst.limit -%}
{%- assign bg_image = sst.background_image -%}
{% style %}
  #shopify-section-{{ section.id }} .distance {
    padding-top: {{ sst.distance_top_xs }}px;
    padding-bottom: {{ sst.distance_bottom_xs }}px;
    {% if sst.background_color != blank or bg_image != blank %}
      background: {{ sst.background_color }}{% if bg_image != blank %} url("{{ bg_image | img_url: '' }}"){% endif %} center;
      background-size: cover;
    {% endif %}
  }
  @media(min-width: 768px) {
    #shopify-section-{{ section.id }} .distance {
      padding-top: {{ sst.distance_top_md }}px;
      padding-bottom: {{ sst.distance_bottom_md }}px;
    }
  }
  @media(min-width: 1200px) {
    #shopify-section-{{ section.id }} .distance {
      padding-top: {{ sst.distance_top_xl }}px;
      padding-bottom: {{ sst.distance_bottom_xl }}px;
    }
  }
  {% if sst.show_nav %}
    #shopify-section-{{ section.id }} .nav-slider {
      color: {{ sst.heading_color }};
    }
    #shopify-section-{{ section.id }} .nav-slider:hover {
      color: var(--color-hover);
    }
  {% endif %}
  {% if sst.show_style %}
    #shopify-section-{{ section.id }} .item-product {
      background-color: {{ sst.product_background }};
    }
    #shopify-section-{{ section.id }} .product__title a {
      color: {{ sst.product_title }};
    }
    #shopify-section-{{ section.id }} .item-product .price-regular,
    #shopify-section-{{ section.id }} .item-product .special-price,
    #shopify-section-{{ section.id }} .item-product .old-price {
      color: {{ sst.product_price }};
    }
    #shopify-section-{{ section.id }} .item-product .jdgm-preview-badge .jdgm-star.jdgm--off {
      color: {{ sst.product_rating_color }};
    }
  {% endif %}
{% endstyle %}
<div class="distance position-relative color-{{ sst.color_section }}{% if sst.class != blank %} {{ sst.class }}{% endif %}{% if sst.animate %} wow fadeInUp animated{% endif %}" data-section-id="{{ section.id }}" data-section-type="nov-slick">
  <div class="{{ sst.container }}">
    <div class="d-flex justify-content-center align-items-center mb-60">
      {% if sst.show_nav %}
        <div class="nav-slider nav-prev"><i class="zmdi zmdi-chevron-left"></i></div>
      {% endif %}
        {% render 'heading-section', class: 'mb-0' %}
      {% if sst.show_nav %}
        <div class="nav-slider nav-next"><i class="zmdi zmdi-chevron-right"></i></div>
      {% endif %}
    </div>
    <div class="grid--view-items nov-slick-carousel spacing-{{ sst.spacing }} spacing-xs-15{% if sst.show_background %} product-background{% endif %}"
      data-autoplay="false"
      data-autoplayTimeout="6000"
      data-loop="false"
      data-dots="{{ sst.show_dots }}"
      data-nav="{{ sst.show_nav }}"
      data-row="1"
      data-items_xxl="{{ sst.xxl }}"
      data-items="{{ sst.xl }}"
      data-items_lg="{{ sst.lg }}"
      data-items_md="{{ sst.md }}"
      data-items_sm="{{ sst.sm }}"
      data-items_xs="{{ sst.xs }}"
      {% if sst.show_nav %}data-custnav{% endif %}>
      {% for product in collection.products limit: product_limit %}
        {% if sectionId == blank %}
          {% assign sectionId = section.id %}
        {% endif %}
          <div class="item sp-item {%- render 'number-to-col' -%}">
            {% render 'product-grid-item-style-2', product: product, sectionId: sectionId %}
          </div>
      {% else %}
        {%- for i in (1..6) -%}
          {%- capture current -%}{% cycle 1, 2, 3, 4 %}{%- endcapture -%}
          <div class="sp-item mb-30 text-center">
            <div>{{ 'product-apparel-' | append: current | placeholder_svg_tag : 'placeholder-svg' }}</div>
            <div class="title h4 mt-15">Lorem ipsum dolor</div>
            <div class="price mt-10 font-700">19$</div>
          </div>
        {%- endfor -%}
      {% endfor %}
    </div>
    {% if sst.viewall %}
    <div class="text-center mt-40">
      <a href="{{ collection.url }}" class="btn {{ sst.btn_type }} {{ sst.btn_size }}">{{ 'sections.button.view_all' | t }}</a>
    </div>
    {% endif %}
  </div>
</div>
{% schema %}
  {
    "name": "Vinova Products Slider 2",
    "class": "section-product-slider-two",
    "settings": [
      {
        "type": "richtext",
        "id": "heading",
        "label": "Heading",
        "default": "<p>Product Slider</p>"
      },
      {
        "type": "color",
        "id": "heading_color",
        "label": "Heading color",
        "default": "#222222"
      },
      {
        "type":  "header",
        "content": "Block product"
      },
      {
        "type": "collection",
        "id": "collection",
        "label": "Collection"
      },
      {
        "type": "checkbox",
        "id": "viewall",
        "label": "Show view all"
      },
      {
        "type": "select",
        "id": "btn_type",
        "label": "Button type",
        "default": "btn-primary",
        "options": [
          { "value": "btn-primary", "label": "Primary" },
          { "value": "btn-secondary", "label": "Secondary" }
        ]
      },
      {
        "type": "select",
        "id": "btn_size",
        "label": "Button size",
        "default": "btn-normal",
        "options": [
          { "value": "btn-normal", "label": "Normal" },
          { "value": "btn-medium", "label": "Medium" },
          { "value": "btn-large", "label": "Large" }
        ]
      },
      {
        "type":  "header",
        "content": "Product item per row"
      },
      {
        "type": "range",
        "id": "xxl",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Desktop",
        "default": 4,
        "info": "Breakpoint 1440px"
      },
      {
        "type": "range",
        "id": "xl",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Large laptop",
        "default": 4,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "range",
        "id": "lg",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Laptop",
        "default": 4,
        "info": "Breakpoint 992px"
      },
      {
        "type": "range",
        "id": "md",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Tablet",
        "default": 3,
        "info": "Breakpoint 768px"
      },
      {
        "type": "range",
        "id": "sm",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Large mobile",
        "default": 2,
        "info": "Breakpoint 576px"
      },
      {
        "type": "range",
        "id": "xs",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Mobile",
        "default": 2,
        "info": "Breakpoint"
      },
      {
        "type":  "header",
        "content": "Slider options"
      },
      {
        "type": "range",
        "id": "limit",
        "min": 4,
        "max": 30,
        "step": 1,
        "label": "Limit",
        "default": 30,
        "info": "Select number limit products"
      },
      {
        "type": "range",
        "id": "spacing",
        "min": 0,
        "max": 70,
        "step": 5,
        "unit": "px",
        "label": "Spacing",
        "default": 30,
        "info": "Spacing item"
      },
      {
        "type": "checkbox",
        "id": "show_nav",
        "label": "Show navigation",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "show_dots",
        "label": "Show dots",
        "default": false
      },
      {
        "type":  "header",
        "content": "Product item style"
      },
      {
        "type": "checkbox",
        "id": "show_style",
        "label": "Show style color",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_background",
        "label": "Show background",
        "default": true
      },
      {
        "type": "color",
        "id": "product_background",
        "label": "Background colors",
        "default": "#fff"
      },
      {
        "type": "color",
        "id": "product_title_color",
        "label": "Color title",
        "default": "#000"
      },
      {
        "type": "color",
        "id": "product_price_color",
        "label": "Color price",
        "default": "#000"
      },
      {
        "type": "color",
        "id": "product_rating_color",
        "label": "Color rating",
        "default": "#c3c3c3"
      },
      {
        "type":  "header",
        "content": "Design option"
      },
      {
        "type": "checkbox",
        "id": "animate",
        "label": "Show animated",
        "default": true
      },
      {
        "type": "select",
        "id": "container",
        "label": "Container",
        "default": "container",
        "options": [
          { "value": "container", "label": "Container" },
          { "value": "container-fluid", "label": "Container fluid" },
          { "value": "container-full", "label": "Container full width" }
        ]
      },
      {
        "type": "color_scheme",
        "id": "color_section",
        "label": "Color section",
        "default": "background-1"
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Background colors"
      },
      {
        "type": "image_picker",
        "id": "background_image",
        "label": "Background image"
      },
      {
        "type": "text",
        "id": "class",
        "label": "Class"
      },
      {
        "type": "header",
        "content": "Spacing top (px)"
      },
      {
        "type": "number",
        "id": "distance_top_xl",
        "label": "Large laptop",
        "default": 30,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "distance_top_md",
        "label": "Tablet",
        "default": 30,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "distance_top_xs",
        "label": "Mobile",
        "default": 30
      },
      {
        "type": "header",
        "content": "Spacing bottom (px)"
      },
      {
        "type": "number",
        "id": "distance_bottom_xl",
        "label": "Large laptop",
        "default": 30,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "distance_bottom_md",
        "label": "Tablet",
        "default": 30,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "distance_bottom_xs",
        "label": "Mobile",
        "default": 30
      }
    ],
    "presets": [
      {
        "name": "Vinova Products Slider 2"
      }
    ]
  }
{% endschema %}
